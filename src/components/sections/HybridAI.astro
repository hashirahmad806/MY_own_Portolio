---
/**
 * HybridAI.astro
 *
 * Authentic Hybrid AI & Agentive Workflow Section from gravity-design.de:
 * - "Die neue Agentur ist hybrid. Mensch und KI, jeder mit seinen Stärken."
 * - Local AI models security guarantee
 * - Interactive Constellation Plexus SVG network (.om-constellation)
 * - Revolving planetary tracks (.cn-track), client nodes, and rotating agent icon discs (.cn-icon)
 * - Interactive magnetic center portal (.om-mitte) expanding to "agentive by design."
 */
---

<section class="om-section" id="hybrid-ai" aria-label="Hybrid AI & Agentic Workflow">
  <div class="om-section-bg" aria-hidden="true"></div>

  <div class="om-section-inner container">
    <!-- Left Column: Editorial Manifesto Narrative -->
    <div class="om-section-left">
      <h2 class="om-section-title">
        Modernes Web-Engineering ist hybrid. <span class="om-accent">Mensch und KI,</span> jeder mit seinen Stärken.
      </h2>

      <div class="om-narrative-stack">
        <p class="om-text">
          Als MERN Stack Developer verbinde ich solide Softwarearchitektur mit modernsten KI-Workflows und Full Stack Best Practices.
        </p>

        <p class="om-text">
          Dazu kommen KI-Agenten und fortschrittliche Toolchains. Sie beschleunigen Recherche, Datenarchitektur und Refactorings. Das Urteil über Codequalität, Sicherheit und saubere Schnittstellen bleibt bei mir.
        </p>

        <!-- Local Models Security Guarantee Box -->
        <div class="om-callout glass-panel">
          <div class="callout-indicator">
            <span class="callout-dot"></span>
            <span class="callout-label">Skalierbar & Sicher</span>
          </div>
          <p class="callout-body">
            <strong>Microservices & WebSockets</strong> — Saubere Architekturen, isolierte APIs, performante Realtime-Systeme und automatisierte CI/CD-Pipelines.
          </p>
        </div>

        <p class="om-text">
          Von reaktiven Frontends mit React & TypeScript bis hin zu hochperformanten Node/Express Backends und MongoDB Datenbanken. Clean Code, Unit Testing und Continuous Integration garantieren verlässliche Systeme in jeder Phase.
        </p>

        <div class="om-claim-hybrid">
          <span class="claim-line">Engineering precision.</span>
          <span class="claim-line text-accent">Artificial intelligence.</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Constellation Plexus -->
    <div class="om-section-right">
      <div class="om-constellation" id="constellation" aria-hidden="true">
        <svg viewBox="0 0 800 800">
          <defs>
            <radialGradient id="cnGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.35"></stop>
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
            </radialGradient>
          </defs>

          <!-- Ambient Glow Core -->
          <circle cx="400" cy="400" r="380" fill="url(#cnGlow)"></circle>

          <!-- Orbital Rings -->
          <circle class="cn-ring" cx="400" cy="400" r="140"></circle>
          <circle class="cn-ring" cx="400" cy="400" r="230"></circle>
          <circle class="cn-ring" cx="400" cy="400" r="320"></circle>

          <!-- Spinning Inner Orbital Track -->
          <g class="cn-track cn-track--inner">
            <circle class="cn-orb cn-orb--accent" cx="400" cy="260" r="8"></circle>
            <circle class="cn-orb" cx="260" cy="400" r="6"></circle>
            <circle class="cn-orb" cx="540" cy="400" r="5"></circle>
            <circle class="cn-orb" cx="400" cy="540" r="7"></circle>
          </g>

          <!-- Spinning Middle Orbital Track with AI Agent Discs -->
          <g class="cn-track cn-track--middle">
            <line x1="400" y1="170" x2="630" y2="400" stroke="var(--fg)" stroke-opacity="0.15" stroke-dasharray="2 3"></line>
            <line x1="630" y1="400" x2="400" y2="630" stroke="var(--fg)" stroke-opacity="0.15" stroke-dasharray="2 3"></line>

            <!-- Agent Node 1: Vision / Creative -->
            <g class="cn-icon cn-icon--farbig" transform="translate(400, 170)">
              <circle class="cn-icon-scheibe" cx="0" cy="0" r="16"></circle>
              <circle cx="0" cy="0" r="5" fill="#101010"></circle>
            </g>

            <!-- Agent Node 2: Strategy / Synthesis -->
            <g class="cn-icon" transform="translate(630, 400)">
              <circle class="cn-icon-scheibe" cx="0" cy="0" r="14"></circle>
              <circle cx="0" cy="0" r="4" fill="var(--accent)"></circle>
            </g>

            <!-- Agent Node 3: Code / 3D Engine -->
            <g class="cn-icon cn-icon--ring" transform="translate(170, 400)">
              <circle class="cn-icon-kreis" cx="0" cy="0" r="14"></circle>
            </g>
          </g>

          <!-- Spinning Outer Track with Client Nodes -->
          <g class="cn-track cn-track--outer">
            <circle class="cn-orb" cx="400" cy="80" r="5"></circle>
            <circle class="cn-orb cn-orb--accent" cx="720" cy="400" r="6"></circle>
            <circle class="cn-orb" cx="400" cy="720" r="5"></circle>
            <circle class="cn-orb" cx="80" cy="400" r="6"></circle>
          </g>
        </svg>

        <!-- Magnetic Center Portal -->
        <a
          href="mailto:losgehts@gravity-design.de?subject=Chemistry-Meeting"
          class="om-mitte"
          id="centerPortal"
          aria-label="Chemistry Meeting anfragen"
          data-cursor-hover
        >
          <span>agentive by design.</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .om-section {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: clamp(80px, 12vh, 160px) 0;
    overflow: hidden;
    background: var(--bg);
    border-top: 1px solid rgba(237, 235, 230, 0.08);
  }

  .om-section-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
    width: 100%;
  }

  /* Left Column Typography */
  .om-section-title {
    font-family: var(--font-display-family);
    font-size: clamp(34px, 4.6vw, 76px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 2rem 0;
  }

  .om-accent {
    color: var(--accent);
  }

  .om-narrative-stack {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    max-width: 620px;
  }

  .om-text {
    font-size: clamp(15px, 1.1vw, 18px);
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
  }

  /* Local Guarantee Callout */
  .om-callout {
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    border-left: 3px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 0.5rem 0;
  }

  .callout-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .callout-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .callout-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
  }

  .callout-body {
    font-size: clamp(14px, 1.05vw, 17px);
    line-height: 1.55;
    color: var(--fg);
    margin: 0;
  }

  .om-claim-hybrid {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-display-family);
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 700;
    margin-top: 1rem;
  }

  /* Right Column: Constellation Plexus */
  .om-section-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 480px;
  }

  .om-constellation {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .om-constellation svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cn-ring {
    fill: none;
    stroke: rgba(237, 235, 230, 0.12);
    stroke-width: 1;
  }

  /* Rotational Tracks */
  .cn-track {
    transform-origin: 400px 400px;
  }

  .cn-track--inner {
    animation: cnSpin 32s linear infinite;
  }

  .cn-track--middle {
    animation: cnSpin 48s linear infinite reverse;
  }

  .cn-track--outer {
    animation: cnSpin 72s linear infinite;
  }

  @keyframes cnSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .cn-orb {
    fill: var(--fg);
    opacity: 0.55;
  }

  .cn-orb--accent {
    fill: var(--accent);
    opacity: 0.9;
    filter: drop-shadow(0 0 6px var(--accent));
  }

  .cn-icon-scheibe {
    fill: var(--accent);
  }

  .cn-icon-kreis {
    fill: var(--fg);
  }

  /* Center Interactive Portal */
  .om-mitte {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(38px, 5vw, 48px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    display: grid;
    place-items: center;
    cursor: pointer;
    text-decoration: none;
    z-index: 10;
    box-shadow: 0 0 24px rgba(180, 129, 248, 0.45);
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.3s ease;
  }

  .om-mitte:hover,
  .om-mitte:focus-visible {
    width: clamp(140px, 16vw, 190px);
    box-shadow: 0 0 40px rgba(180, 129, 248, 0.7);
  }

  .om-mitte span {
    color: #101010;
    white-space: nowrap;
    font-size: clamp(11px, 0.95vw, 13px);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.28s ease 0.08s, transform 0.28s ease 0.08s;
  }

  .om-mitte:hover span,
  .om-mitte:focus-visible span {
    opacity: 1;
    transform: none;
  }

  /* Responsive Adjustments */
  @media (max-width: 960px) {
    .om-section-inner {
      grid-template-columns: 1fr;
    }

    .om-section-right {
      min-height: 380px;
    }
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .cn-track { animation: none; }
    .om-mitte { transition: none; }
  }
</style>
