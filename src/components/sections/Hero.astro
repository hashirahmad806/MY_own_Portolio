---
/**
 * Hero.astro
 *
 * Full-Bleed 1080p Celestial Hero Stage from gravity-design.de:
 * - High-contrast black & white portrait backdrop (#bg) with WebGL depth map parallax (#bgTiefe)
 * - 1920x1080 fixed coordinate stage (#stage, #scene) with adaptive aspect ratio layout
 * - Celestial atomic structure: gold sun (#mass), doughnut ring (#ring), white satellite (#small), attractor (#attractor)
 * - Concentric guide ellipses (#guide-small, #guide-ring) and focal points (#focus-small, #focus-ring)
 * - Dynamic live telemetry HUD monospace readouts (#coord-small, #coord-ring)
 * - "strategy · concept · design" claim (#claim)
 * - Editorial name and role lockup with scroll character scrub (#lockup)
 * - Interactive Click to Gravitize: Keplerian orbital mechanics with spring return
 * - Seamless scroll docking to header wordmark (#svg -> #brand)
 */
---

<!-- Ambient Depth Texture -->
<div class="om-tiefe" aria-hidden="true"></div>

<!-- Full-Stage Portrait Backdrop with WebGL 2.5D Depth Displacement Canvas -->
<div class="om-bg" id="bg">
  <canvas class="om-bg-tiefe" id="bgTiefe" aria-hidden="true"></canvas>
</div>

<!-- 1920x1080 Celestial Stage -->
<header class="stage" id="stage" aria-label="Hashir Ahmad — Celestial Stage">
  <div class="scene" id="scene">
    <div class="om-mark" id="mark">
      <div class="om-lockup" id="lockup">
        <h1 class="om-name">hashir ahmad</h1>
        <p class="om-role">mern stack developer &amp; <span class="om-rolle-zwei">software engineer</span></p>
      </div>

      <p class="om-claim" id="claim">react · node · typescript · microservices</p>
    </div>
  </div>

  <!-- Primary Celestial Orbital SVG Structure -->
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" aria-hidden="true">
    <defs></defs>

    <!-- Concentric Orbital Ellipse Guides -->
    <ellipse id="guide-small" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0"></ellipse>
    <ellipse id="guide-ring" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0"></ellipse>

    <!-- Celestial Focus Points -->
    <circle id="focus-small" r="5" fill="var(--accent)" opacity="0"></circle>
    <circle id="focus-ring" r="5" fill="var(--accent)" opacity="0"></circle>

    <!-- Telemetry HUD Monospace Coordinates -->
    <text font-size="16" font-family="monospace" fill="var(--accent)" opacity="0" id="coord-small">
      <tspan id="coord-small-xy">0, 0</tspan>
      <tspan id="coord-small-a">a 0.0</tspan>
    </text>
    <text font-size="16" font-family="monospace" fill="var(--accent)" opacity="0" id="coord-ring">
      <tspan id="coord-ring-xy">0, 0</tspan>
      <tspan id="coord-ring-a">a 0.0</tspan>
    </text>

    <!-- Click-to-Gravitize Dynamic Attractor Marker -->
    <circle id="attractor" r="9" fill="var(--accent)" opacity="0"></circle>

    <!-- Planetary Orbital Bodies -->
    <circle id="mass" fill="var(--accent)"></circle>
    <circle id="small" fill="var(--fg)" opacity="0"></circle>
    <circle id="ring" fill="none" stroke="var(--fg)" opacity="0"></circle>
  </svg>

  <!-- Interactive Gravitize Hint -->
  <div class="om-hint" id="hint">click to gravitize</div>
</header>

<style>
  #mass, #small, #ring {
    transition: fill .4s ease, stroke .4s ease;
  }

  .om-tiefe {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--bg) var(--tiefe, url('/tiefe.png') 0 0 / 100% 100% no-repeat);
    pointer-events: none;
    transform: translateZ(0);
  }

  .om-bg {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 150vh;
    background: var(--bg);
    --photo: url('/portrait.jpg');
  }

  .om-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--photo) var(--photo-x, 100%) var(--photo-y, 0px) / max(128%, 150vh) auto no-repeat;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .om-bg.is-loaded::after {
    opacity: 1;
  }

  .om-bg-tiefe {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100vh;
    width: 100%;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    transform: translateZ(0);
  }

  .om-bg.is-loaded .om-bg-tiefe {
    opacity: 1;
  }

  .om-bg.is-tiefe::after {
    opacity: 0;
    transition: none;
  }

  .om-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    transition: background .4s ease;
    background: linear-gradient(100deg, var(--overlay-1) 0%, var(--overlay-2) 45%, var(--overlay-3) 75%);
  }

  .stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 6;
    overflow: hidden;
    background: transparent;
    cursor: crosshair;
  }

  .scene {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform-origin: 0 0;
    pointer-events: none;
  }

  #svg {
    position: absolute;
    inset: auto;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform-origin: 0 0;
    pointer-events: none;
  }

  :global(html.logo-gedockt) #svg {
    pointer-events: none;
  }

  .om-mark {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform: scale(0.7);
    transform-origin: 960px 536px;
  }

  .om-lockup {
    position: absolute;
    left: -58px;
    top: 943px;
    white-space: nowrap;
    color: var(--fg);
    opacity: 0;
    transform: translateY(18px);
    transition: color .4s ease, opacity 1s ease .3s, transform 1s ease .3s;
    pointer-events: auto;
  }

  .om-lockup.is-da {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.om-lz) {
    display: inline-block;
  }

  .om-name {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin: 0;
    text-transform: lowercase;
  }

  .om-role {
    font-size: 20px;
    font-weight: 400;
    opacity: .66;
    letter-spacing: 0.1em;
    margin: 0.6em 0 0;
  }

  .om-claim {
    position: absolute;
    left: 1120px;
    top: 646px;
    white-space: nowrap;
    margin: 0;
    font-size: 35px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    opacity: 0;
    transform: translateY(calc(-50% + 18px));
    transition: opacity 1s ease .3s, transform 1s ease .3s, color .3s ease;
    pointer-events: auto;
  }

  .om-claim.is-da {
    opacity: 1;
    transform: translateY(-50%);
  }

  .om-hint {
    position: absolute;
    left: 50%;
    bottom: 38px;
    transform: translateX(-50%);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(237, 235, 230, 0.65);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    transition: opacity 0.6s ease;
  }

  #guide-small, #guide-ring {
    stroke: var(--accent);
    transition: stroke .3s ease;
  }

  #focus-small, #focus-ring, #attractor, #mass {
    fill: var(--accent);
    transition: fill .3s ease;
  }

  #coord-small, #coord-ring {
    fill: var(--accent);
    transition: fill .3s ease;
  }

  :global(html.mass-on-accent) #mass {
    fill: var(--logo-on-accent, var(--bg));
  }

  :global(html.mass-on-light) #mass,
  :global(html.mass-on-light) #small {
    fill: var(--bg);
  }

  :global(html.mass-on-light) #ring {
    stroke: var(--bg);
  }

  @media (orientation: portrait) {
    .om-bg {
      --photo-x: 38%;
    }
    .om-lockup {
      left: 109px;
      top: 1003px;
    }
    .om-name, .om-role {
      font-size: 30px;
    }
    .om-claim {
      font-size: 48px;
    }
  }

  @media (max-width: 640px) {
    .om-name, .om-role {
      font-size: 48px;
    }
    .om-claim {
      top: 985px;
      font-size: 60px;
      letter-spacing: 0.04em;
    }
    .om-lockup {
      top: 1108px;
    }
    .om-rolle-zwei {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .om-bg::after {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  import { initDepthCanvas } from '../../scripts/depth-canvas';
  import { initHeroStage } from '../../scripts/hero-stage';

  const startHero = () => {
    initDepthCanvas();
    initHeroStage();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startHero);
  } else {
    startHero();
  }
  document.addEventListener('astro:page-load', startHero);
</script>
