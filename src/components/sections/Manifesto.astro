---
/**
 * Manifesto.astro
 *
 * Authentic Manifesto Section from gravity-design.de:
 * - Organic SVG Bold Curve Transition (#boldCurve, #boldCurvePath) with spring bounce
 * - Pinned #boldScroll with sticky #boldSection (circular clip-path reveal)
 * - Revolving satellite orbital ring (#mfRing) with magnetic cursor attraction
 * - Categorical label "Manifest"
 * - Staggered masked editorial typography (.om-manifesto) with 3D perspective zoom
 * - Strike-through animation on "Agentur" and underline on "bold"
 * - "Drag to orbit" teaser hint
 */
---

<!-- Organic SVG Bold Curve Transition -->
<svg class="om-bold-curve" id="boldCurve" viewBox="0 0 1000 160" preserveAspectRatio="none" aria-hidden="true">
  <path id="boldCurvePath" d="M0,0 Q500,-140 1000,0 L1000,160 L0,160 Z" fill="var(--accent)"></path>
</svg>

<div class="om-bold-scroll" id="boldScroll">
  <section class="om-bold" id="boldSection">
    <!-- Orbital Ring & Revolving Satellite Dot with Magnetic Cursor Physics -->
    <div class="mf-ring-feld" id="mfRing" aria-hidden="true">
      <div class="mf-ring"></div>
      <div class="mf-ring-kreisel">
        <div class="mf-ring-bahn">
          <i class="mf-punkt"></i>
        </div>
      </div>
    </div>

    <!-- Category Label -->
    <div class="mf-label">Manifest</div>

    <!-- Manifesto Typography Grid -->
    <div class="om-manifesto" id="manifesto">
      <!-- Line 1: Agentur ohne Agentur -->
      <div class="mf-line">
        <span>Agentur</span>
        <span>ohne</span>
        <span><span class="mf-strike">Agentur</span>.</span>
      </div>

      <!-- Line 2: 35 Jahre Erfahrung -->
      <div class="mf-line">
        <span class="mf-paar">
          <span>35</span>
          <span>Jahre</span>
        </span>
        <span>Erfahrung.</span>
      </div>

      <!-- Line 3: Kein Overhead & Editorial Stack -->
      <div class="mf-line mf-line--stapel">
        <span class="mf-phrase">Kein Overhead.</span>
        <div class="mf-stapel">
          <p class="mf-copy">Gute Ideen sind am Anfang oft fragil. Zu viele Abstimmungen, Kompromisse und Prozesse können ihnen genau das nehmen, was sie stark macht: ihren Mut und ihr Momentum.</p>
          <p class="mf-copy">Strategie gibt einer Idee Halt. Erfahrung zeigt, was funktioniert. Und Intuition sagt manchmal: genau so – auch wenn das Naheliegende in eine andere Richtung zeigt. So wird aus einer mutigen Idee eine mit echter Anziehungskraft. Eine, die trägt.</p>
          <p class="mf-copy">Nicht der Anspruch hat sich verändert, sondern die Mittel. Was früher ein großes Team und ein großes Budget brauchte, entsteht heute in kleiner Besetzung. Das verschiebt die Grenze des Möglichen. Nach oben.</p>
        </div>
      </div>

      <!-- Line 4: Just bold ideas -->
      <div class="mf-line mf-line--ende">
        <span class="mf-phrase mf-schluss">Just <span class="om-bold-underline">bold</span> ideas.</span>

        <span class="mf-anhang">
          <span class="mf-strich" aria-hidden="true"></span>
          <span class="mf-nachsatz">for brands, reports and digital worlds</span>
        </span>
      </div>
    </div>

    <!-- Drag to Orbit Teaser Hint -->
    <div class="orbit-hint" id="orbitHint" aria-hidden="true">
      <span>Drag</span>
      <span>to</span>
      <span>orbit</span>
    </div>
  </section>
</div>

<style>
  .om-bold-curve {
    position: relative;
    z-index: 3;
    inset: auto;
    display: block;
    width: 100%;
    height: 176px;
    margin-top: -2px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .om-bold-scroll {
    position: relative;
    height: 430vh;
  }

  .om-bold {
    position: sticky;
    top: 0;
    z-index: 1;
    width: 100%;
    height: 100vh;
    background: var(--accent);
    color: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 56px;
    text-align: center;
    transition: background .3s ease;
    clip-path: circle(80vmax at 50% 50%);
    -webkit-clip-path: circle(80vmax at 50% 50%);
    overflow: hidden;
    perspective: 1400px;
    --ring-d: 80vmin;
  }

  .om-bold.is-collapsing {
    transition: none;
  }

  .mf-ring-feld {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    left: 50%;
    top: 50%;
    width: var(--ring-d);
    height: var(--ring-d);
    margin: calc(var(--ring-d) / -2) 0 0 calc(var(--ring-d) / -2);
    transform: translateY(var(--ring-y, -24vh));
    will-change: transform;
  }

  .mf-ring-kreisel {
    position: absolute;
    inset: 0;
    transform: scale(var(--punkt-s, 1));
  }

  .mf-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform: scale(var(--ring-s, 1));
    background: linear-gradient(to bottom, rgba(242, 240, 236, .45), rgba(242, 240, 236, .65));
    -webkit-mask: radial-gradient(closest-side, transparent 39.8%, #000 40.4%);
    mask: radial-gradient(closest-side, transparent 39.8%, #000 40.4%);
  }

  .mf-ring-bahn {
    position: absolute;
    inset: 0;
    animation: mf-bahn 26s linear infinite;
  }

  @keyframes mf-bahn {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .mf-punkt {
    position: absolute;
    top: -8px;
    left: 50%;
    margin-left: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #F2F0EC;
    display: block;
    box-shadow: 0 0 12px rgba(242, 240, 236, 0.45);
    transition: transform 0.1s ease-out;
  }

  .mf-label, .om-manifesto {
    position: relative;
    z-index: 1;
  }

  .mf-label {
    text-transform: uppercase;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(16, 16, 16, 0.55);
    margin-bottom: 2rem;
    text-align: left;
    max-width: var(--content-max);
    margin-inline: auto;
    width: 100%;
  }

  .om-manifesto {
    max-width: var(--content-max);
    width: 100%;
    margin: 0 auto;
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(34px, min(6.4vw, 11vh), 108px);
    letter-spacing: 0.005em;
    line-height: 0.92;
    --mf-line-h: 0.12em;
  }

  .mf-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    transform-origin: 50% 50%;
    will-change: transform, opacity, filter;
  }

  .mf-paar {
    display: inline-flex;
    gap: 0.28em;
  }

  :global(.mf-maske) {
    overflow: hidden;
    display: inline-block;
    vertical-align: bottom;
  }

  :global(.mf-hoch) {
    display: inline-block;
    transform: translateY(115%);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .om-manifesto.is-auf :global(.mf-hoch) {
    transform: none;
  }

  .mf-line--stapel {
    align-items: flex-start;
  }

  .mf-phrase {
    white-space: nowrap;
  }

  .mf-stapel {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 480px;
    margin-left: 2rem;
    text-transform: none;
  }

  .mf-copy {
    font-size: clamp(13px, 0.95vw, 15px);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: rgba(16, 16, 16, 0.78);
    margin: 0;
  }

  .mf-line--ende {
    justify-content: flex-start;
    align-items: center;
    margin-top: 0.5em;
    gap: 2rem;
  }

  .mf-line--ende .mf-phrase {
    color: var(--fg);
    transition: color .3s ease;
  }

  .mf-anhang {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    text-transform: none;
  }

  .mf-strich {
    width: 48px;
    height: 2px;
    background: currentColor;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .om-manifesto.is-auf .mf-strich {
    opacity: .55;
  }

  .mf-nachsatz {
    font-size: clamp(14px, 1.1vw, 18px);
    font-weight: 500;
    opacity: 0;
    transition: opacity 0.6s ease 0.2s;
  }

  .om-manifesto.is-auf .mf-nachsatz {
    opacity: 1;
  }

  .mf-strike {
    position: relative;
  }

  .mf-strike::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 52%;
    height: var(--mf-line-h);
    background: #F2F0EC;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .mf-strike.is-struck::after {
    transform: scaleX(1);
  }

  .om-bold-underline {
    position: relative;
  }

  .om-bold-underline::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.02em;
    height: var(--mf-line-h);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .om-bold-underline.is-struck::after {
    transform: scaleX(1);
  }

  .orbit-hint {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
    opacity: 0;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: #F2F0EC;
    font-size: clamp(13px, 1.15vw, 17px);
    transition: opacity 0.3s ease;
  }

  .orbit-hint span {
    display: block;
  }

  @media (max-width: 640px) {
    .om-bold-scroll {
      height: 348vh;
    }
    .om-bold {
      padding: clamp(40px, 9vh, 96px) var(--rand) 40px;
    }
    .om-manifesto {
      font-size: clamp(26px, 9.4vw, 52px);
      line-height: 0.7;
    }
    .mf-line {
      justify-content: flex-start;
      gap: 0.28em;
      flex-wrap: wrap;
    }
    .mf-stapel {
      margin-left: 0;
      margin-top: 0.7em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mf-ring-feld { transform: none; }
    .mf-ring-bahn { animation: none; }
    :global(.mf-hoch) { transform: none; transition: none; }
    .mf-strich, .mf-nachsatz { opacity: 1; transition: none; }
    .mf-strike::after, .om-bold-underline::after { transform: scaleX(1); transition: none; }
  }
</style>

<script>
  import { initManifestoScroll } from '../../scripts/manifesto-scroll';

  const startManifesto = () => {
    initManifestoScroll();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startManifesto);
  } else {
    startManifesto();
  }
  document.addEventListener('astro:page-load', startManifesto);
</script>
