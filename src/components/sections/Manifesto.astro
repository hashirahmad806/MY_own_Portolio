---
/**
 * Manifesto.astro
 *
 * Authentic Manifesto Section from gravity-design.de:
 * - SVG Bold Curve transition (M0,0 Q500,-140 1000,0 L1000,160 L0,160 Z)
 * - Full-bleed celestial lilac background (#B481F8) with circular clip-path reveal
 * - Rotating orbital satellite ring (.mf-ring-feld, .mf-ring-bahn, .mf-punkt)
 * - Masked typographic slide-ups (.mf-maske, .mf-hoch)
 * - Dynamic strike-through on "Agentur ohne Agentur" and underline on "bold"
 * - Drag to orbit teaser hint
 */
---

<!-- Organic SVG Bold Curve Transition -->
<svg class="om-bold-curve" id="boldCurve" viewBox="0 0 1000 160" preserveAspectRatio="none" aria-hidden="true">
  <path id="boldCurvePath" d="M0,0 Q500,-140 1000,0 L1000,160 L0,160 Z" fill="var(--accent)"></path>
</svg>

<div class="om-bold-scroll" id="boldScroll">
  <section class="om-bold" id="boldSection">
    <!-- Orbital Ring & Revolving Satellite Dot -->
    <div class="mf-ring-feld" id="mfRing" aria-hidden="true">
      <div class="mf-ring"></div>
      <div class="mf-ring-kreisel">
        <div class="mf-ring-bahn">
          <i class="mf-punkt"></i>
        </div>
      </div>
    </div>

    <!-- Category Label -->
    <div class="mf-label">Manifest</div>

    <!-- Manifesto Typography Grid -->
    <div class="om-manifesto" id="manifesto">
      <!-- Line 1: Agentur ohne Agentur -->
      <div class="mf-line">
        <span class="mf-maske"><span class="mf-hoch">Agentur</span></span>
        <span class="mf-maske"><span class="mf-hoch">ohne</span></span>
        <span class="mf-maske"><span class="mf-hoch"><span class="mf-strike">Agentur</span>.</span></span>
      </div>

      <!-- Line 2: 35 Jahre Erfahrung -->
      <div class="mf-line">
        <span class="mf-paar">
          <span class="mf-maske"><span class="mf-hoch">35</span></span>
          <span class="mf-maske"><span class="mf-hoch">Jahre</span></span>
        </span>
        <span class="mf-maske"><span class="mf-hoch">Erfahrung.</span></span>
      </div>

      <!-- Line 3: Kein Overhead & Editorial Stack -->
      <div class="mf-line mf-line--stapel">
        <span class="mf-maske"><span class="mf-hoch"><span class="mf-phrase">Kein Overhead.</span></span></span>
        <div class="mf-stapel">
          <p class="mf-copy">Gute Ideen sind am Anfang oft fragil. Zu viele Abstimmungen, Kompromisse und Prozesse können ihnen genau das nehmen, was sie stark macht: ihren Mut und ihr Momentum.</p>
          <p class="mf-copy">Strategie gibt einer Idee Halt. Erfahrung zeigt, was funktioniert. Und Intuition sagt manchmal: genau so – auch wenn das Naheliegende in eine andere Richtung zeigt. So wird aus einer mutigen Idee eine mit echter Anziehungskraft. Eine, die trägt.</p>
          <p class="mf-copy">Nicht der Anspruch hat sich verändert, sondern die Mittel. Was früher ein großes Team und ein großes Budget brauchte, entsteht heute in kleiner Besetzung. Das verschiebt die Grenze des Möglichen. Nach oben.</p>
        </div>
      </div>

      <!-- Line 4: Just bold ideas -->
      <div class="mf-line mf-line--ende">
        <span class="mf-maske"><span class="mf-hoch"><span class="mf-phrase mf-schluss">Just <span class="om-bold-underline">bold</span> ideas.</span></span></span>

        <span class="mf-anhang">
          <span class="mf-strich" aria-hidden="true"></span>
          <span class="mf-nachsatz">for brands, reports and digital worlds</span>
        </span>
      </div>
    </div>

    <!-- Drag to Orbit Teaser Hint -->
    <div class="orbit-hint" id="orbitHint" aria-hidden="true">
      <span>Drag</span>
      <span>to</span>
      <span>orbit</span>
    </div>
  </section>
</div>

<style>
  /* SVG Bold Curve Transition */
  .om-bold-curve {
    position: relative;
    z-index: 3;
    inset: auto;
    display: block;
    width: 100%;
    height: 176px;
    margin-top: -2px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .om-bold-scroll {
    position: relative;
    height: 380vh;
  }

  @media (pointer: coarse) {
    .om-bold-scroll {
      height: 320vh;
    }
  }

  /* Sticky Marquee Section */
  .om-bold {
    position: sticky;
    top: 0;
    z-index: 2;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: var(--accent);
    color: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px clamp(24px, 4vw, 56px);
    text-align: center;
    clip-path: circle(80vmax at 50% 50%);
    -webkit-clip-path: circle(80vmax at 50% 50%);
    overflow: hidden;
    perspective: 1400px;
    --ring-d: 80vmin;
    --mf-line-h: 0.12em;
  }

  /* Orbital Ring Background */
  .mf-ring-feld {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    left: 50%;
    top: 50%;
    width: var(--ring-d);
    height: var(--ring-d);
    margin: calc(var(--ring-d) / -2) 0 0 calc(var(--ring-d) / -2);
    transform: translateY(var(--ring-y, -24vh));
    will-change: transform;
  }

  .mf-ring-kreisel {
    position: absolute;
    inset: 0;
    transform: scale(var(--punkt-s, 1));
  }

  .mf-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform: scale(var(--ring-s, 1));
    background: linear-gradient(to bottom, rgba(242, 240, 236, 0.45), rgba(242, 240, 236, 0.65));
    -webkit-mask: radial-gradient(closest-side, transparent 39.8%, #000 40.4%);
            mask: radial-gradient(closest-side, transparent 39.8%, #000 40.4%);
  }

  .mf-ring-bahn {
    position: absolute;
    inset: 0;
    animation: mf-bahn 26s linear infinite;
  }

  .mf-punkt {
    position: absolute;
    left: 50%;
    top: calc(var(--ring-d) * -0.06);
    width: clamp(10px, 1.65vmin, 22px);
    height: clamp(10px, 1.65vmin, 22px);
    margin-left: calc(clamp(10px, 1.65vmin, 22px) / -2);
    border-radius: 50%;
    background: #F2F0EC;
    will-change: transform;
  }

  @keyframes mf-bahn {
    to { transform: rotate(360deg); }
  }

  /* Typography Structure */
  .mf-label,
  .om-manifesto {
    position: relative;
    z-index: 1;
  }

  .mf-label {
    max-width: var(--content-max);
    margin: 0 auto 20px;
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.22em;
    color: #F2F0EC;
  }

  .om-manifesto {
    max-width: var(--content-max);
    margin: 0 auto;
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(34px, min(6.4vw, 11vh), 108px);
    letter-spacing: 0.005em;
    line-height: 0.92;
  }

  .mf-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mf-maske {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding: 0.3em 0;
    margin: -0.3em 0;
  }

  .mf-hoch {
    display: inline-block;
    will-change: transform;
    transform: translateY(calc(100% + 0.55em));
    transition: transform 1.05s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .om-manifesto.is-auf .mf-hoch {
    transform: none;
  }

  .mf-paar,
  .mf-paar .mf-hoch {
    display: inline-flex;
    gap: 0.28em;
  }

  .mf-line--stapel {
    align-items: flex-start;
  }

  .mf-stapel {
    flex: 1 1 0;
    min-width: 0;
    margin-top: 0.25em;
    margin-left: 2.2em;
  }

  .mf-copy {
    flex: 0 0 auto;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0.01em;
    line-height: 1.45;
    font-size: clamp(11px, max(1.3vw, 1.3vh), 17px);
    margin: 0;
  }

  .mf-copy + .mf-copy {
    margin-top: 1.45em;
  }

  .mf-line--ende {
    justify-content: flex-start;
    align-items: center;
    margin-top: 0.5em;
  }

  .mf-anhang {
    display: inline-flex;
    align-items: center;
    align-self: center;
    flex: 1 1 auto;
    min-width: 0;
    margin-bottom: 0.14em;
  }

  .mf-strich {
    flex: 1 1 0;
    align-self: center;
    width: auto;
    min-width: 24px;
    height: 2px;
    background: var(--fg);
    opacity: 0;
    margin: 0 clamp(14px, 1.4vw, 28px);
    transition: opacity 0.8s ease 0.45s;
  }

  .om-manifesto.is-auf .mf-strich {
    opacity: 0.55;
  }

  .mf-nachsatz {
    flex: 0 0 auto;
    align-self: center;
    color: var(--fg);
    text-transform: none;
    font-size: clamp(12px, 1.05vw, 17px);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
    opacity: 0;
    transition: opacity 0.8s ease 0.45s;
  }

  .om-manifesto.is-auf .mf-nachsatz {
    opacity: 1;
  }

  /* Live Strikethrough & Underline Animation */
  .mf-strike {
    position: relative;
  }

  .mf-strike::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 52%;
    height: var(--mf-line-h);
    background: #F2F0EC;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .mf-strike.is-struck::after {
    transform: scaleX(1);
  }

  .om-bold-underline {
    position: relative;
  }

  .om-bold-underline::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.02em;
    height: var(--mf-line-h);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .om-bold-underline.is-struck::after {
    transform: scaleX(1);
  }

  /* Drag Hint */
  .orbit-hint {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
    opacity: 0;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: #F2F0EC;
    font-size: clamp(13px, 1.15vw, 17px);
    transition: opacity 0.4s ease;
  }

  .orbit-hint.is-da {
    opacity: 1;
  }

  .orbit-hint span {
    display: block;
  }

  /* Mobile Portrait Adjustments */
  @media (max-width: 900px) {
    .om-manifesto {
      font-size: clamp(32px, 7.8vw, 68px);
    }

    .mf-line--stapel {
      flex-direction: column;
    }

    .mf-stapel {
      margin-left: 0;
      margin-top: 1rem;
    }

    .mf-copy {
      font-size: 14px;
    }
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .mf-ring-feld { transform: none; }
    .mf-ring-bahn { animation: none; }
    .mf-hoch { transform: none; transition: none; }
    .mf-strich, .mf-nachsatz { opacity: 1; transition: none; }
    .mf-strike::after, .om-bold-underline::after { transform: scaleX(1); transition: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initManifesto = () => {
    const scroller = document.getElementById('boldScroll');
    const boldSection = document.getElementById('boldSection');
    const manifesto = document.getElementById('manifesto');
    const strike = document.querySelector('.mf-strike');
    const underline = document.querySelector('.om-bold-underline');
    const orbitHint = document.getElementById('orbitHint');

    if (!scroller || !boldSection || !manifesto) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      manifesto.classList.add('is-auf');
      strike?.classList.add('is-struck');
      underline?.classList.add('is-struck');
      return;
    }

    // ── Reveal on entering section ──
    ScrollTrigger.create({
      trigger: scroller,
      start: 'top 75%',
      onEnter: () => manifesto.classList.add('is-auf'),
    });

    // ── Strikethrough & Underline progression on scroll ──
    ScrollTrigger.create({
      trigger: scroller,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => {
        const p = self.progress;
        if (strike) strike.classList.toggle('is-struck', p >= 0.05);
        if (underline) underline.classList.toggle('is-struck', p >= 0.15);
        if (orbitHint) orbitHint.classList.toggle('is-da', p >= 0.35 && p <= 0.85);
      },
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initManifesto);
  } else {
    initManifesto();
  }
  document.addEventListener('astro:page-load', initManifesto);
</script>
