</style>

<script>
  // Client interactions and animation scripts for Bio section
  document.addEventListener('DOMContentLoaded', () => {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Character Scrub Wave (FENSTER = 14)
    const slots = Array.from(document.querySelectorAll<HTMLElement>('.om-bio-slot'));
    if (slots.length && !isReduced) {
      const FENSTER = 14;
      let einspaltig = false;

      function zerlegen(el: Node): HTMLElement[] {
        const liste: HTMLElement[] = [];
        (function lauf(knoten: Node) {
          const kinder = Array.from(knoten.childNodes);
          for (let n = 0; n < kinder.length; n++) {
            const k = kinder[n];
            if (k.nodeType === Node.TEXT_NODE) {
              const roh = k.nodeValue || '';
              const frag = document.createDocumentFragment();
              for (let i = 0; i < roh.length; i++) {
                const c = roh.charAt(i);
                if (c === ' ' || c === '\u00A0' || c === '\n' || c === '\t') {
                  frag.appendChild(document.createTextNode(c));
                  continue;
                }
                const sp = document.createElement('span');
                sp.className = 'z';
                sp.textContent = c;
                frag.appendChild(sp);
                liste.push(sp);
              }
              knoten.replaceChild(frag, k);
            } else if (k.nodeType === Node.ELEMENT_NODE) {
              lauf(k);
            }
          }
        })(el);
        return liste;
      }

      interface Posten {
        slot: HTMLElement;
        text: HTMLElement | null;
        z: HTMLElement[];
        unter: HTMLElement | null;
        unterAb: number;
        gezogen: boolean;
        klebe: number;
        hoehe: number;
        dok: number;
        schacht: number;
        lo: number;
        hi: number;
      }

      const posten: Posten[] = slots
        .map((slot) => {
          const text = slot.querySelector<HTMLElement>('.om-bio-text');
          const z = text ? zerlegen(text) : [];
          const unter = text ? text.querySelector<HTMLElement>('.om-unterstrich') : null;
          let abIndex = -1;
          if (unter) {
            const erstes = unter.querySelector<HTMLElement>('span.z');
            abIndex = erstes ? z.indexOf(erstes) : -1;
          }
          return {
            slot,
            text,
            z,
            unter,
            unterAb: abIndex,
            gezogen: false,
            klebe: 0,
            hoehe: 0,
            dok: 0,
            schacht: 0,
            lo: 0,
            hi: -1,
          };
        })
        .filter((p) => p.z.length > 0);

      function strichSetzen(p: Posten, an: boolean) {
        if (!p.unter || p.gezogen === an) return;
        p.gezogen = an;
        p.unter.classList.toggle('is-gezogen', an);
      }

      function dokTop(el: HTMLElement | null): number {
        let y = 0;
        for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement) {
          y += n.offsetTop;
        }
        return y;
      }

      function klebeElement(text: HTMLElement | null): HTMLElement | null {
        if (!text) return null;
        if (getComputedStyle(text).position === 'sticky') return text;
        const el = text.parentElement;
        if (el && getComputedStyle(el).position === 'sticky') return el;
        return null;
      }

      function messen() {
        if (!posten.length) return;
        einspaltig = !klebeElement(posten[0].text);
        posten.forEach((p) => {
          const ke = klebeElement(p.text) || p.text;
          if (!ke) return;
          p.klebe = parseFloat(getComputedStyle(ke).top) || 0;
          p.hoehe = ke.getBoundingClientRect().height;
          p.dok = dokTop(p.slot);
          p.schacht = p.slot.offsetHeight;
        });
      }

      function fenster(p: Posten, lo: number, hi: number) {
        lo = lo < 0 ? 0 : lo;
        hi = hi > p.z.length - 1 ? p.z.length - 1 : hi;
        if (lo > hi) {
          lo = 0;
          hi = -1;
        }
        if (lo === p.lo && hi === p.hi) return;
        for (let i = p.lo; i <= p.hi; i++) {
          if (p.z[i] && (i < lo || i > hi)) p.z[i].classList.remove('is-hot');
        }
        for (let i = lo; i <= hi; i++) {
          if (p.z[i] && (i < p.lo || i > p.hi)) p.z[i].classList.add('is-hot');
        }
        p.lo = lo;
        p.hi = hi;
      }

      function rechnen() {
        const y = window.pageYOffset || document.documentElement.scrollTop;
        for (let k = 0; k < posten.length; k++) {
          const p = posten[k];
          const oben = p.dok - y;
          if (einspaltig) {
            fenster(p, 0, -1);
            strichSetzen(p, oben < window.innerHeight * 0.55);
            continue;
          }
          const weg = p.schacht - p.hoehe;
          let t = weg > 0 ? (p.klebe - oben) / weg : 0;
          t = t < 0 ? 0 : t > 1 ? 1 : t;

          const front = Math.floor(t * (p.z.length + 2 * FENSTER)) - FENSTER;
          fenster(p, front - FENSTER + 1, front);
          strichSetzen(p, front >= p.unterAb);
        }
      }

      let geplant = false;
      function anstossen() {
        if (geplant) return;
        geplant = true;
        requestAnimationFrame(() => {
          geplant = false;
          rechnen();
        });
      }

      messen();
      rechnen();
      window.addEventListener('scroll', anstossen, { passive: true });
      window.addEventListener('resize', () => {
        messen();
        rechnen();
      });
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          messen();
          rechnen();
        });
      }
    }

    // 2. Sticky Key Highlight via IntersectionObserver
    const keys = Array.from(document.querySelectorAll<HTMLElement>('.om-bio-key'));
    if (keys.length && 'IntersectionObserver' in window) {
      const drin = keys.map(() => false);

      function aktualisieren() {
        let aktiv = -1;
        for (let i = 0; i < keys.length; i++) {
          if (drin[i]) aktiv = i;
        }
        for (let j = 0; j < keys.length; j++) {
          keys[j].classList.toggle('is-current', j === aktiv);
        }
      }

      function melden(entries: IntersectionObserverEntry[]) {
        entries.forEach((e) => {
          const idx = keys.indexOf(e.target as HTMLElement);
          if (idx !== -1) drin[idx] = e.isIntersecting;
        });
        aktualisieren();
      }

      let beobachter: IntersectionObserver[] = [];
      function bauen() {
        beobachter.forEach((o) => o.disconnect());
        beobachter = [];
        const vh = window.innerHeight;
        keys.forEach((k) => {
          let park = parseFloat(getComputedStyle(k).top);
          if (isNaN(park)) {
            park = parseFloat(getComputedStyle(k.parentElement!).top) || 0;
          }
          const LUFT = 6;
          const linie = Math.min(vh * 0.9, park + LUFT);
          const unten = Math.max(0, Math.round(vh - linie));
          const o = new IntersectionObserver(melden, {
            rootMargin: `0px 0px -${unten}px 0px`,
            threshold: 0,
          });
          o.observe(k);
          beobachter.push(o);
        });
      }

      bauen();
      window.addEventListener('resize', bauen);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(bauen);
      }
    }

    // 3. Exhibition Image Parallax
    const block = document.querySelector<HTMLElement>('.om-bio-bilder');
    if (block && !isReduced) {
      let geplantParallax = false;
      function messenParallax() {
        const r = block!.getBoundingClientRect();
        block!.style.setProperty(
          '--bild-weg',
          `${(window.innerHeight / 2 - (r.top + r.height / 2)).toFixed(1)}px`
        );
      }
      function anstossenParallax() {
        if (geplantParallax) return;
        geplantParallax = true;
        requestAnimationFrame(() => {
          geplantParallax = false;
          messenParallax();
        });
      }
      messenParallax();
      window.addEventListener('scroll', anstossenParallax, { passive: true });
      window.addEventListener('resize', anstossenParallax);
    }

    // 4. Invitation Word Splitter & Reveal
    const einladung = document.getElementById('bioEinladung');
    if (einladung) {
      const worte = (einladung.textContent || '').trim().split(/\s+/);
      einladung.textContent = '';
      worte.forEach((wort, i) => {
        const maske = document.createElement('span');
        maske.className = 'mf-maske';
        const innen = document.createElement('span');
        innen.className = 'mf-hoch';
        innen.textContent = wort;
        innen.style.transitionDelay = `${(i * 0.06).toFixed(3)}s`;
        maske.appendChild(innen);
        einladung.appendChild(maske);
        if (i < worte.length - 1) einladung.appendChild(document.createTextNode(' '));
      });
    }

    const els = document.querySelectorAll<HTMLElement>('.reveal');
    if (els.length && 'IntersectionObserver' in window) {
      function zeige(el: HTMLElement) {
        el.classList.add('is-in');
        ioZeitpunkt.unobserve(el);
        ioSicher.unobserve(el);
      }
      const ioZeitpunkt = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) zeige(e.target as HTMLElement);
          });
        },
        { threshold: 0, rootMargin: '0px 0px -20% 0px' }
      );
      const ioSicher = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) zeige(e.target as HTMLElement);
          });
        },
        { threshold: 0.85 }
      );
      els.forEach((el) => {
        ioZeitpunkt.observe(el);
        ioSicher.observe(el);
      });
    }

    // 5. Mobile Dynamic DOM Restructuring (<=720px)
    if (window.innerWidth <= 720) {
      const halter = Array.from(document.querySelectorAll<HTMLElement>('.om-bio-halt'));
      const schaechte: HTMLElement[] = [];
      halter.forEach((halt) => {
        if (halt.classList.contains('om-bio-halt--label')) return;
        const schacht = halt.nextElementSibling as HTMLElement | null;
        if (!schacht || !schacht.classList.contains('om-bio-slot')) return;
        const b = document.createElement('div');
        b.className = 'om-bio-block';
        while (schacht.firstChild) b.appendChild(schacht.firstChild);
        if (halt.firstElementChild) b.insertBefore(halt.firstElementChild, b.firstChild);
        halt.remove();
        schacht.appendChild(b);
        schaechte.push(schacht);
      });

      const label = document.querySelector<HTMLElement>('.om-bio-halt--label');
      if (label && schaechte.length) {
        const auftakt = document.createElement('div');
        auftakt.className = 'om-bio-auftakt';
        label.parentNode?.insertBefore(auftakt, label);

        const schleier = document.createElement('div');
        schleier.className = 'om-bio-schleier';
        schleier.setAttribute('aria-hidden', 'true');
        auftakt.appendChild(schleier);
        auftakt.appendChild(label);
        schaechte.forEach((s) => auftakt.appendChild(s));
      }
    }

    // 6. GitHub Contribution Grid Generator (52 weeks x 7 days)
    const gridEl = document.getElementById('ghContribGrid');
    if (gridEl) {
      const frag = document.createDocumentFragment();
      const weeks = 52;
      const daysPerWeek = 7;
      for (let w = 0; w < weeks; w++) {
        for (let d = 0; d < daysPerWeek; d++) {
          const cell = document.createElement('div');
          cell.className = 'om-gh-cell';
          const recency = w / weeks;
          const rand = Math.sin(w * 13.7 + d * 7.9) * 0.5 + 0.5;
          let level = 0;
          if (rand > 0.42 || (recency > 0.7 && rand > 0.25)) {
            if (rand > 0.88) level = 4;
            else if (rand > 0.72) level = 3;
            else if (rand > 0.55) level = 2;
            else level = 1;
          }
          if (w === weeks - 1 && d >= 5) {
            level = 3;
          }
          if (level > 0) {
            cell.classList.add(`level-${level}`);
            cell.title = `${level * 2} contributions`;
          } else {
            cell.title = 'No contributions';
          }
          frag.appendChild(cell);
        }
      }
      gridEl.appendChild(frag);
    }
  });
</script>
