---
// src/components/sections/Bio.astro
// Authentic 100% replica of gravity-design.de Bio, Client Roster & Awards Vault
---

<section class="om-bio" id="bio" aria-label="Bio, Clients und Awards">
  <div class="om-bio-licht" aria-hidden="true"></div>
  <div class="om-bio-grid">

    <!-- Column 1: Sticky Bio/ Label -->
    <div class="om-bio-halt om-bio-halt--label" style="grid-row: 1 / 5">
      <h2 class="om-bio-label">Bio/</h2>
    </div>

    <!-- Slot 1: My Story -->
    <div class="om-bio-halt" style="--i:0; grid-row: 1 / 5">
      <h3 class="om-bio-key">My Story</h3>
    </div>
    <div class="om-bio-slot" style="--i:0; grid-row: 1">
      <p class="om-bio-text">
        MERN Stack Developer mit Fokus auf performante Webanwendungen, skalierbare Microservices und außergewöhnliche User Experiences.<span class="om-bio-abs"></span>
        Spezialisiert auf modernste Frontend- und Backend-Architekturen: React, Node.js, Express, MongoDB, TypeScript und Astro.<span class="om-bio-abs"></span>
        Committed to lifelong learning and adopting emerging technologies that drive business value and exceptional user experiences.
      </p>
    </div>

    <!-- Slot 2: Core Competencies -->
    <div class="om-bio-halt" style="--i:1; grid-row: 2 / 5">
      <h3 class="om-bio-key">Skills</h3>
    </div>
    <div class="om-bio-slot" style="--i:1; grid-row: 2">
      <p class="om-bio-text">
        Gezielte Praxiserfahrung in zukunftssicheren Technologien und Methoden:<span class="om-bio-abs"></span>
        <span class="om-accent">Responsive Design</span>&nbsp;· Microservices&nbsp;· WebSockets&nbsp;· Unit Testing&nbsp;· CI/CD Pipelines&nbsp;· SEO Optimization&nbsp;· Accessibility (A11y)&nbsp;· State Management&nbsp;· RESTful APIs &amp; GraphQL.
      </p>
    </div>

    <!-- Slot 3: Certifications -->
    <div class="om-bio-halt" style="--i:2; grid-row: 3 / 5">
      <h3 class="om-bio-key">Awards</h3>
    </div>
    <div class="om-bio-slot" style="--i:2; grid-row: 3">
      <p class="om-bio-text">
        Zertifizierungen &amp; Qualifikationen:<span class="om-bio-abs"></span>
        <a class="om-verweis" href="https://github.com/hashirahmad806" target="_blank" rel="noopener">Meta Certified Frontend &amp; Full Stack Specialist<svg class="om-verweis-zeichen" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M9 15 L15 9 M10.4 9 H15 V13.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>&nbsp;· Certified MERN Stack Web Developer&nbsp;· Microservices &amp; Node.js Backend Architect&nbsp;· Advanced State Management (Redux/Zustand)&nbsp;· Cloud Deployment &amp; DevOps.
      </p>
    </div>

    <!-- Slot 4: GitHub Live Activity -->
    <div class="om-bio-halt" style="--i:3; grid-row: 4 / 5">
      <h3 class="om-bio-key">GitHub/</h3>
    </div>
    <div class="om-bio-slot om-bio-slot--github" style="--i:3; grid-row: 4">
      <div class="om-github-card">
        <!-- Profile Header -->
        <div class="om-gh-header">
          <div class="om-gh-user">
            <span class="om-gh-handle">@hashirahmad806</span>
            <span class="om-gh-badge">WEB DEVELOPER</span>
          </div>
          <div class="om-gh-social">
            <span><strong>3</strong> Followers</span>
            <span class="om-gh-dot">·</span>
            <span><strong>2</strong> Following</span>
          </div>
        </div>

        <!-- Metric Badges -->
        <div class="om-gh-stats-grid">
          <div class="om-gh-stat-box">
            <span class="om-gh-stat-num">228</span>
            <span class="om-gh-stat-label">TOTAL CONTRIBUTIONS<br/><small>last year</small></span>
          </div>
          <div class="om-gh-stat-box">
            <span class="om-gh-stat-num">42</span>
            <span class="om-gh-stat-label">PUBLIC REPOSITORIES<br/><small>active repos</small></span>
          </div>
          <div class="om-gh-stat-box">
            <span class="om-gh-stat-num">2 Days</span>
            <span class="om-gh-stat-label">CURRENT STREAK<br/><small>consecutive active</small></span>
          </div>
          <div class="om-gh-stat-box">
            <span class="om-gh-stat-num">9 Days</span>
            <span class="om-gh-stat-label">LONGEST STREAK<br/><small>historical record</small></span>
          </div>
        </div>

        <!-- Most Used Languages -->
        <div class="om-gh-lang-section">
          <h4 class="om-gh-subtitle">Most Used Languages</h4>
          <div class="om-gh-lang-bar">
            <div class="om-gh-bar-seg js" style="width: 33%" title="JavaScript 33%"></div>
            <div class="om-gh-bar-seg jupyter" style="width: 22%" title="Jupyter Notebook 22%"></div>
            <div class="om-gh-bar-seg ts" style="width: 11%" title="TypeScript 11%"></div>
            <div class="om-gh-bar-seg html" style="width: 11%" title="HTML 11%"></div>
            <div class="om-gh-bar-seg astro" style="width: 8%" title="Astro 8%"></div>
            <div class="om-gh-bar-seg other" style="width: 15%" title="Other 15%"></div>
          </div>
          <div class="om-gh-lang-pills">
            <span class="lang-pill"><i class="dot dot-js"></i> JavaScript <strong>33%</strong></span>
            <span class="lang-pill"><i class="dot dot-jupyter"></i> Jupyter Notebook <strong>22%</strong></span>
            <span class="lang-pill"><i class="dot dot-ts"></i> TypeScript <strong>11%</strong></span>
            <span class="lang-pill"><i class="dot dot-html"></i> HTML <strong>11%</strong></span>
            <span class="lang-pill"><i class="dot dot-astro"></i> Astro <strong>8%</strong></span>
          </div>
        </div>

        <!-- Contribution Grid (Last 365 Days) -->
        <div class="om-gh-grid-section">
          <div class="om-gh-grid-header">
            <h4 class="om-gh-subtitle">Contribution Grid <span class="om-gh-dim">Last 365 Days</span></h4>
            <span class="om-gh-subnote">* Pushes reflect commits and platform updates</span>
          </div>
          <div class="om-gh-grid-wrap" id="ghContribGrid">
            <!-- Grid generated by inline script -->
          </div>
          <div class="om-gh-grid-legend">
            <span>Less</span>
            <i class="sq sq-0"></i>
            <i class="sq sq-1"></i>
            <i class="sq sq-2"></i>
            <i class="sq sq-3"></i>
            <i class="sq sq-4"></i>
            <span>More</span>
          </div>
        </div>

        <!-- Recent Push Activity Feed -->
        <div class="om-gh-pushes">
          <h4 class="om-gh-subtitle">Recent Push Activity</h4>
          <div class="om-gh-push-list">
            <div class="om-gh-push-item">
              <div class="om-gh-push-meta">
                <span class="om-gh-icon">⚡</span>
                <span class="om-gh-repo">MY_own_Portolio</span>
                <span class="om-gh-time">2 hours ago</span>
              </div>
              <p class="om-gh-commit-msg">feat(hero-stage): authentic 1080p celestial atomic physics, click-to-gravitize and second-section scroll engine</p>
              <div class="om-gh-commit-sha">
                <code>SHA: fb348a1</code>
                <a href="https://github.com/hashirahmad806/MY_own_Portolio/commit/fb348a1" target="_blank" rel="noopener">View Commit &rarr;</a>
              </div>
            </div>

            <div class="om-gh-push-item">
              <div class="om-gh-push-meta">
                <span class="om-gh-icon">⚡</span>
                <span class="om-gh-repo">MY_own_Portolio</span>
                <span class="om-gh-time">5 hours ago</span>
              </div>
              <p class="om-gh-commit-msg">docs(grill): record GLOSSARY, ADRs 0001-0004, dedicated impressum page, active hemisphere video playback, and hybrid hero telemetry</p>
              <div class="om-gh-commit-sha">
                <code>SHA: 90994ea</code>
                <a href="https://github.com/hashirahmad806/MY_own_Portolio/commit/90994ea" target="_blank" rel="noopener">View Commit &rarr;</a>
              </div>
            </div>

            <div class="om-gh-push-item">
              <div class="om-gh-push-meta">
                <span class="om-gh-icon">⚡</span>
                <span class="om-gh-repo">MY_own_Portolio</span>
                <span class="om-gh-time">5 hours ago</span>
              </div>
              <p class="om-gh-commit-msg">feat(phase-05): implement authentic bio 3-column sticky grid, clients, awards vault, and exhibition parallax</p>
              <div class="om-gh-commit-sha">
                <code>SHA: ead34a9</code>
                <a href="https://github.com/hashirahmad806/MY_own_Portolio/commit/ead34a9" target="_blank" rel="noopener">View Commit &rarr;</a>
              </div>
            </div>

            <div class="om-gh-push-item">
              <div class="om-gh-push-meta">
                <span class="om-gh-icon">⚡</span>
                <span class="om-gh-repo">AimalShah/triostepdkhyber</span>
                <span class="om-gh-time">yesterday</span>
              </div>
              <p class="om-gh-commit-msg">Updated project</p>
              <div class="om-gh-commit-sha">
                <code>SHA: bb8766a</code>
                <a href="https://github.com/hashirahmad806/triostepdkhyber/commit/bb8766a" target="_blank" rel="noopener">View Commit &rarr;</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="om-gh-footer">
          <a class="om-gh-cta-btn" href="https://github.com/hashirahmad806" target="_blank" rel="noopener">
            View All 42 Repositories on GitHub &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Slot 5: Exhibition Photo & Quote -->
    <div class="om-bio-bilder" style="grid-row: 5">
      <img
        class="om-bio-bild om-bio-bild--versetzt"
        id="bioExhibitionImg"
        src="/awards-ausstellung.jpg"
        width="1400"
        height="1866"
        loading="lazy"
        decoding="async"
        alt="Hashir Ahmad — MERN Stack Developer"
      />

      <blockquote class="om-bio-zitat reveal">
        <p class="om-bio-zitat-satz">
          „Committed to lifelong learning and adopting emerging technologies that drive business value and exceptional user experiences.“
        </p>
        <cite class="om-bio-zitat-name">Hashir Ahmad</cite>
      </blockquote>
    </div>

    <!-- Invitation transition -->
    <p class="om-bio-einladung reveal" id="bioEinladung">Lust auf ein gemeinsames Projekt? Let’s connect.</p>

  </div>
</section>

<style>
  .om-marke,
  .om-heureka {
    font-weight: 700;
  }

  .om-accent {
    color: var(--accent);
  }

  .om-bio {
    position: relative;
    z-index: 4;
    overflow: clip;
    --bio-kante: 100%;
    background-color: var(--bg);
    color: var(--fg);
    --bio-pad-x: 56px;
    --bio-pad-oben: clamp(96px, 14vh, 190px);
    padding: var(--bio-pad-oben) var(--bio-pad-x) clamp(80px, 12vh, 160px);
    --bio-top: max(288px, 16vh);
    --bio-key: clamp(34px, 5.2vw, 88px);
    --bio-copy: clamp(20px, min(2.8vw, 4vh), 44px);
    --bio-step: calc(var(--bio-key) * 1.12);
    --bio-gasse: clamp(40px, 5.3vw, 130px);
  }

  .om-bio-licht {
    position: sticky;
    top: 0;
    z-index: 0;
    transform: translateZ(0);
    height: 100vh;
    margin: calc(-1 * var(--bio-pad-oben)) calc(-1 * var(--bio-pad-x)) calc(var(--bio-pad-oben) - 100vh);
    background: var(--bg) var(--tiefe);
    pointer-events: none;
  }

  .om-bio-grid {
    position: relative;
    z-index: 1;
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    grid-template-rows: repeat(4, auto) auto;
    column-gap: 0;
    row-gap: clamp(60px, 10vh, 140px);
  }

  .om-bio-label,
  .om-bio-key {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.005em;
    line-height: 1;
    white-space: nowrap;
    position: sticky;
  }

  .om-bio-halt {
    grid-column: 2;
  }

  .om-bio-halt--label {
    grid-column: 1;
  }

  .om-bio-label {
    top: var(--bio-top);
    font-size: var(--bio-key);
  }

  .om-bio-key {
    top: calc(var(--bio-top) + var(--i) * var(--bio-step));
    font-size: var(--bio-key);
    margin: 0 0 calc((3 - var(--i)) * var(--bio-step)) 0.18em;
    color: var(--fg);
    transition: color 0.8s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .om-bio-key.is-current {
    color: var(--accent);
  }

  .om-bio-abs {
    display: block;
    height: 0.62em;
  }

  .om-bio-slot {
    grid-column: 3;
    min-height: var(--bio-lesen, 130vh);
  }

  .om-bio-text {
    position: sticky;
    top: calc(var(--bio-top) + var(--i) * var(--bio-step));
    margin: 0 0 0 var(--bio-gasse);
    font-weight: 400;
    letter-spacing: 0.01em;
    font-size: var(--bio-copy);
    line-height: 1.24;
  }

  :global(.om-bio-text .z) {
    transition: color 0.38s ease;
  }

  :global(.om-bio-text .z.is-hot) {
    color: var(--accent);
  }

  .om-verweis {
    color: inherit;
    text-decoration: none;
  }

  .om-verweis-zeichen {
    position: static;
    inset: auto;
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-left: 0.3em;
    vertical-align: -0.1em;
    color: var(--accent);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .om-verweis:hover .om-verweis-zeichen,
  .om-verweis:focus-visible .om-verweis-zeichen {
    opacity: 0.65;
    transform: translate(0.1em, -0.1em);
  }

  .om-unterstrich {
    position: relative;
    display: inline-block;
  }

  .om-unterstrich::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.06em;
    height: max(2px, 0.055em);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  :global(.om-unterstrich.is-gezogen::after) {
    transform: scaleX(1);
  }

  /* GitHub Live Activity Card */
  .om-bio-slot--github {
    margin-left: var(--bio-gasse);
    min-height: auto;
    padding-bottom: clamp(60px, 10vh, 120px);
  }

  .om-github-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    padding: clamp(20px, 3vw, 36px);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    max-width: 820px;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .om-github-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.6;
    pointer-events: none;
  }

  .om-gh-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .om-gh-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .om-gh-handle {
    font-size: clamp(17px, 1.4vw, 22px);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-family: monospace;
    color: var(--fg);
  }

  .om-gh-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(180, 129, 248, 0.12);
    color: var(--accent);
    border: 1px solid rgba(180, 129, 248, 0.3);
  }

  .om-gh-social {
    font-size: 13px;
    color: color-mix(in srgb, var(--fg) 65%, transparent);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .om-gh-social strong {
    color: var(--fg);
    font-weight: 700;
  }

  .om-gh-dot {
    opacity: 0.35;
  }

  .om-gh-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 28px;
  }

  .om-gh-stat-box {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    padding: 16px 14px;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }

  .om-gh-stat-box:hover {
    border-color: rgba(180, 129, 248, 0.35);
    background: rgba(180, 129, 248, 0.04);
    transform: translateY(-2px);
  }

  .om-gh-stat-num {
    display: block;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--accent);
    font-family: monospace;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }

  .om-gh-stat-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 60%, transparent);
    line-height: 1.35;
  }

  .om-gh-stat-label small {
    display: block;
    font-size: 9px;
    font-weight: 400;
    text-transform: none;
    opacity: 0.7;
    margin-top: 1px;
  }

  .om-gh-subtitle {
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .om-gh-lang-section,
  .om-gh-grid-section {
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.045);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 24px;
  }

  .om-gh-lang-bar {
    display: flex;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    gap: 2px;
    background: rgba(255, 255, 255, 0.06);
    margin-bottom: 14px;
  }

  .om-gh-bar-seg {
    height: 100%;
    transition: opacity 0.2s ease;
  }
  .om-gh-bar-seg:hover {
    opacity: 0.8;
  }
  .om-gh-bar-seg.js { background: #f7df1e; }
  .om-gh-bar-seg.jupyter { background: #da5b0b; }
  .om-gh-bar-seg.ts { background: #3178c6; }
  .om-gh-bar-seg.html { background: #e34c26; }
  .om-gh-bar-seg.astro { background: #ff5d01; }
  .om-gh-bar-seg.other { background: #6e7681; }

  .om-gh-lang-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .lang-pill {
    font-size: 12px;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lang-pill strong {
    color: var(--fg);
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-js { background: #f7df1e; }
  .dot-jupyter { background: #da5b0b; }
  .dot-ts { background: #3178c6; }
  .dot-html { background: #e34c26; }
  .dot-astro { background: #ff5d01; }

  .om-gh-grid-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }

  .om-gh-dim {
    font-size: 11px;
    font-weight: 400;
    opacity: 0.6;
    text-transform: none;
    margin-left: 6px;
  }

  .om-gh-subnote {
    font-size: 11px;
    color: color-mix(in srgb, var(--fg) 45%, transparent);
    font-style: italic;
  }

  .om-gh-grid-wrap {
    display: grid;
    grid-template-rows: repeat(7, 10px);
    grid-auto-flow: column;
    grid-auto-columns: 10px;
    gap: 3px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
  }

  .om-gh-grid-wrap::-webkit-scrollbar {
    height: 4px;
  }
  .om-gh-grid-wrap::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
  }

  :global(.om-gh-cell) {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.05);
    transition: transform 0.15s ease, filter 0.15s ease;
    cursor: pointer;
  }

  :global(.om-gh-cell:hover) {
    transform: scale(1.4);
    z-index: 2;
    position: relative;
    filter: brightness(1.2);
  }

  :global(.om-gh-cell.level-1) {
    background: rgba(180, 129, 248, 0.32);
  }
  :global(.om-gh-cell.level-2) {
    background: rgba(180, 129, 248, 0.58);
  }
  :global(.om-gh-cell.level-3) {
    background: rgba(180, 129, 248, 0.82);
  }
  :global(.om-gh-cell.level-4) {
    background: var(--accent);
    box-shadow: 0 0 6px rgba(180, 129, 248, 0.6);
  }

  .om-gh-grid-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-size: 11px;
    color: color-mix(in srgb, var(--fg) 50%, transparent);
    margin-top: 10px;
  }

  .sq {
    width: 9px;
    height: 9px;
