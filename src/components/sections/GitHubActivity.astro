    z-index: 1;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 26px;
  }

  .gh-avatar-container {
    position: relative;
    width: 68px;
    height: 68px;
    flex-shrink: 0;
  }

  .gh-avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), #5a8cfa, var(--accent));
    animation: ghRingRotate 8s linear infinite;
    opacity: 0.85;
  }

  @keyframes ghRingRotate {
    to { transform: rotate(360deg); }
  }

  .gh-avatar-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: #111;
    border: 2px solid #0e0e12;
  }

  .gh-online-badge {
    position: absolute;
    bottom: 2px;
    right: 2px;
    z-index: 2;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #10b981;
    border: 2.5px solid #0e0e12;
    box-shadow: 0 0 6px #10b981;
  }

  .gh-profile-meta {
    flex-grow: 1;
  }

  .gh-name-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 4px;
  }

  .gh-name {
    margin: 0;
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .gh-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(180, 129, 248, 0.15);
    color: var(--accent);
    border: 1px solid rgba(180, 129, 248, 0.35);
  }

  .gh-handle-link {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    color: color-mix(in srgb, var(--fg) 65%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .gh-handle-link:hover {
    color: var(--accent);
  }

  .gh-bio-headline {
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
  }

  .gh-counts-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 12px;
    color: color-mix(in srgb, var(--fg) 60%, transparent);
  }

  .gh-counts-row strong {
    color: var(--fg);
    font-weight: 700;
  }

  .gh-sep {
    opacity: 0.3;
  }

  /* ── Metric Cards Deck ── */
  .gh-metrics-deck {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .gh-metric-tile {
    position: relative;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 18px 16px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, background 0.25s ease;
    overflow: hidden;
  }

  .gh-metric-tile:hover {
    transform: translateY(-3px);
    border-color: rgba(180, 129, 248, 0.4);
    background: rgba(180, 129, 248, 0.035);
  }

  .gh-tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .gh-tile-tag {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .gh-tile-icon {
    color: var(--accent);
    opacity: 0.7;
  }

  .gh-tile-number {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(26px, 2.5vw, 36px);
    font-weight: 800;
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }

  .gh-tile-desc {
    font-size: 11px;
    font-weight: 600;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
    line-height: 1.3;
  }

  .gh-tile-desc small {
    display: block;
    font-size: 9px;
    font-weight: 400;
    opacity: 0.65;
    margin-top: 2px;
  }

  /* ── Telemetry Health Ribbon ── */
  .gh-health-ribbon {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    margin-bottom: 24px;
  }

  .gh-health-pill {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 10px;
  }

  .gh-pill-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--fg) 45%, transparent);
    font-size: 9px;
    font-weight: 700;
  }

  .gh-pill-val {
    color: var(--accent);
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  /* ── Language Radar & Filter ── */
  .gh-lang-card,
  .gh-matrix-card {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.018);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .gh-subhead-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .gh-section-title {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--fg);
  }

  .gh-title-note {
    font-size: 10px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: color-mix(in srgb, var(--fg) 50%, transparent);
  }

  .gh-filter-indicator,
  .gh-card-count {
    font-size: 11px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: var(--accent);
  }

  .gh-lang-bar {
    display: flex;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    gap: 2px;
    background: rgba(255, 255, 255, 0.06);
    margin-bottom: 14px;
  }

  .gh-bar-seg {
    height: 100%;
    transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .gh-bar-seg:hover {
    opacity: 0.8;
  }

  .gh-bar-seg.js { background: #f7df1e; }
  .gh-bar-seg.jupyter { background: #da5b0b; }
  .gh-bar-seg.ts { background: #3178c6; }
  .gh-bar-seg.html { background: #e34c26; }
  .gh-bar-seg.astro { background: #ff5d01; }
  .gh-bar-seg.other { background: #a855f7; }

  .gh-lang-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .gh-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 999px;
    padding: 6px 12px;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gh-filter-btn strong {
    color: var(--fg);
  }

  .gh-filter-btn:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .gh-filter-btn.is-active {
    background: rgba(180, 129, 248, 0.18);
    border-color: var(--accent);
    color: var(--accent);
  }

  .gh-filter-btn.is-active strong {
    color: var(--accent);
  }

  .gh-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-all { background: #fff; }
  .dot-client { background: #f59e0b; }
  .dot-ai { background: var(--accent); }
  .dot-js { background: #f7df1e; }
  .dot-ts { background: #3178c6; }
  .dot-astro { background: #ff5d01; }
  .dot-react { background: #61dafb; }

  /* ── Contribution Matrix ── */
  .gh-matrix-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  .gh-matrix-total {
    font-size: 11px;
    color: color-mix(in srgb, var(--fg) 65%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .gh-matrix-total strong {
    color: var(--accent);
  }

  .gh-matrix-months {
    display: flex;
    justify-content: space-between;
    padding-left: 28px;
    margin-bottom: 6px;
    font-size: 9px;
    color: color-mix(in srgb, var(--fg) 40%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .gh-matrix-viewport {
    display: flex;
    gap: 6px;
    align-items: flex-start;
  }

  .gh-matrix-days-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 84px;
    font-size: 9px;
    color: color-mix(in srgb, var(--fg) 40%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    padding-top: 2px;
  }

  .gh-matrix-grid {
    display: grid;
    grid-template-rows: repeat(7, 10px);
    grid-auto-flow: column;
    grid-auto-columns: 10px;
    gap: 3px;
    overflow-x: auto;
    padding-bottom: 10px;
    flex-grow: 1;
    scrollbar-width: thin;
    scrollbar-color: rgba(180, 129, 248, 0.3) transparent;
  }

  .gh-matrix-grid::-webkit-scrollbar {
    height: 4px;
  }

  .gh-matrix-grid::-webkit-scrollbar-thumb {
    background: rgba(180, 129, 248, 0.3);
    border-radius: 4px;
  }

  :global(.om-gh-cell) {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.04);
    transition: transform 0.15s ease, filter 0.15s ease, opacity 0.25s ease;
    cursor: pointer;
    outline: none;
  }

  :global(.om-gh-cell:hover),
  :global(.om-gh-cell:focus-visible) {
    transform: scale(1.6);
    z-index: 10;
    position: relative;
    filter: brightness(1.3) drop-shadow(0 0 4px var(--accent));
  }

  :global(.om-gh-cell.level-1) {
    background: rgba(180, 129, 248, 0.28);
  }
  :global(.om-gh-cell.level-2) {
    background: rgba(180, 129, 248, 0.55);
  }
  :global(.om-gh-cell.level-3) {
    background: rgba(180, 129, 248, 0.82);
  }
  :global(.om-gh-cell.level-4) {
    background: var(--accent);
    box-shadow: 0 0 6px rgba(180, 129, 248, 0.6);
  }

  :global(.om-gh-cell.is-dimmed) {
    opacity: 0.15 !important;
  }

  .gh-matrix-foot {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 11px;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
  }

  .gh-matrix-legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .gh-legend-text {
    font-size: 10px;
  }

  .sq {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .sq:hover {
    transform: scale(1.25);
    border-color: #fff;
  }

  .sq.is-active {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .sq-0 { background: rgba(255, 255, 255, 0.05); }
  .sq-1 { background: rgba(180, 129, 248, 0.28); }
  .sq-2 { background: rgba(180, 129, 248, 0.55); }
  .sq-3 { background: rgba(180, 129, 248, 0.82); }
  .sq-4 { background: var(--accent); }

  .gh-legend-reset {
    background: transparent;
    border: none;
    color: var(--accent);
    font-size: 10px;
    margin-left: 6px;
    cursor: pointer;
    text-decoration: underline;
  }

  /* ── Featured Repositories ── */
  .gh-repos-cockpit {
    position: relative;
    z-index: 1;
    margin-bottom: 28px;
  }

  .gh-repos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .gh-repo-card {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .gh-repo-card:hover {
    border-color: rgba(180, 129, 248, 0.35);
    background: rgba(180, 129, 248, 0.035);
    transform: translateY(-2px);
  }

  .gh-repo-card.is-hidden {
    display: none;
  }

  .gh-repo-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .gh-repo-name-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gh-repo-folder-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .gh-repo-name {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: var(--fg);
  }

  .gh-repo-tag {
    font-size: 9px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(180, 129, 248, 0.12);
    color: var(--accent);
    border: 1px solid rgba(180, 129, 248, 0.25);
  }

  /* ── Featured Repository Visual Preview ── */
  .gh-repo-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    margin: 10px 0 14px;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .gh-repo-thumb:hover {
    border-color: rgba(180, 129, 248, 0.45);
    box-shadow: 0 8px 24px rgba(180, 129, 248, 0.2);
  }

  .gh-repo-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }

  .gh-repo-card:hover .gh-repo-thumb img {
    transform: scale(1.06);
    filter: brightness(1.08) contrast(1.02);
  }

  .gh-repo-thumb-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 50%, rgba(13, 13, 17, 0.8) 100%);
    transition: opacity 0.3s ease;
  }

  .gh-repo-thumb-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(18, 18, 24, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--fg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    transition: all 0.2s ease;
  }

  .gh-repo-thumb-badge.live {
    background: rgba(16, 185, 129, 0.18);
    border-color: rgba(16, 185, 129, 0.4);
    color: #10b981;
  }

  .gh-repo-thumb:hover .gh-repo-thumb-badge.live {
    background: rgba(16, 185, 129, 0.3);
    border-color: #10b981;
    transform: translateY(-1px);
  }

  .gh-repo-desc {
    margin: 0 0 14px;
    font-size: 11px;
    line-height: 1.45;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
    flex-grow: 1;
  }

  .gh-repo-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 10px;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
  }

  .gh-tech-spec {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .gh-star-fork {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: color-mix(in srgb, var(--fg) 70%, transparent);
  }

  .gh-repo-tag.client {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.35);
  }

  .gh-repo-tag.ai {
    background: rgba(180, 129, 248, 0.18);
    color: var(--accent);
    border-color: rgba(180, 129, 248, 0.4);
  }

  .gh-repo-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .gh-repo-links-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .gh-btn-live {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #10b981;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gh-btn-live:hover {
    background: #10b981;
    color: #032115;
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.55);
    transform: translateY(-1px);
  }

  .gh-btn-clone {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 10px;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .gh-btn-clone:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .gh-btn-visit {
    color: var(--accent);
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .gh-btn-visit:hover {
    opacity: 0.8;
    transform: translateX(2px);
  }

  /* ── Dual-Mode Telemetry Console ── */
  .gh-telemetry-console {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .gh-console-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .gh-console-tabs {
    display: flex;
    gap: 8px;
  }

  .gh-mode-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: color-mix(in srgb, var(--fg) 70%, transparent);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .gh-mode-tab:hover {
    background: rgba(255, 255, 255, 0.07);
    color: var(--fg);
  }

  .gh-mode-tab.is-active {
    background: rgba(180, 129, 248, 0.15);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 700;
  }

  .gh-live-stream-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #10b981;
  }

  .gh-stream-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    animation: ghPing 2s infinite;
  }

  .gh-view-pane {
    display: none;
  }

