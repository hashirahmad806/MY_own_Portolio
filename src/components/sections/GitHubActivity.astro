---
/**
 * GitHubActivity.astro
 *
 * Real-Time Interactive GitHub Telemetry Engine & Activity Cockpit:
 * - Dynamic REST API Synchronization (hashirahmad806) with offline caching
 * - Scroll-Triggered Animated Metric Counters (GSAP + ScrollTrigger)
 * - Interactive Language Radar & Repository Filter System
 * - Authentic 52-Week Contribution Matrix with Floating Tooltip & Wave Ripple
 * - Interactive Featured Repositories with 3D Tilt & Magnetic Sheen
 * - Dual-Mode Live Telemetry: Visual Commit Feed & Interactive Shell Terminal
 * - One-Click Git Clone & Commit SHA Clipboard Toast System
 */
---

<div class="om-github-card" id="githubCockpit" aria-label="GitHub Real-Time Telemetry and Engineering Activity">
  <!-- Ambient Cosmic Glow Accent -->
  <div class="gh-cosmic-glow" aria-hidden="true"></div>

  <!-- Telemetry Header Status Bar -->
  <div class="gh-status-bar">
    <div class="gh-status-indicator">
      <span class="gh-pulse-dot" aria-hidden="true"></span>
      <span class="gh-status-text" id="ghStatusBadge">LIVE REST TELEMETRY · API v3</span>
      <span class="gh-status-ping" id="ghPingMs">24ms</span>
    </div>
    <div class="gh-utc-clock">
      <span class="gh-clock-icon" aria-hidden="true">⏱</span>
      <span id="ghUtcTime">00:00:00 UTC</span>
      <span class="gh-sync-tag">SYNCED</span>
    </div>
    <div class="gh-quick-actions">
      <button class="gh-action-btn" id="ghCopyCloneBtn" type="button" aria-label="Copy git clone command">
        <svg class="gh-svg" viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path>
          <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path>
        </svg>
        <span>Clone Portfolio</span>
      </button>
      <a class="gh-action-btn gh-action-btn--primary" href="https://github.com/hashirahmad806" target="_blank" rel="noopener noreferrer">
        <svg class="gh-svg" viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        <span>Profile ↗</span>
      </a>
    </div>
  </div>

  <!-- Developer Identity Header -->
  <div class="gh-profile-hero">
    <div class="gh-avatar-container">
      <div class="gh-avatar-ring" aria-hidden="true"></div>
      <img
        class="gh-avatar-img"
        id="ghAvatar"
        src="https://avatars.githubusercontent.com/u/208626941?v=4"
        alt="Hashir Ahmad GitHub Avatar"
        width="68"
        height="68"
        loading="lazy"
      />
      <span class="gh-online-badge" title="Active on GitHub" aria-hidden="true"></span>
    </div>

    <div class="gh-profile-meta">
      <div class="gh-name-row">
        <h4 class="gh-name">Hashir Ahmad</h4>
        <span class="gh-verified-badge" title="Meta Certified Full-Stack Specialist">
          <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" aria-hidden="true">
            <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path>
          </svg>
          ACTIVE ENGINEER
        </span>
        <a class="gh-handle-link" href="https://github.com/hashirahmad806" target="_blank" rel="noopener noreferrer">@hashirahmad806</a>
      </div>
      <p class="gh-bio-headline">
        MERN Stack &amp; Scalable Web Architect · Responsive Systems · Microservices · Keplerian Celestial Shaders
      </p>
      <div class="gh-counts-row">
        <span class="gh-count-item"><strong id="ghFollowersCount">3</strong> Followers</span>
        <span class="gh-sep">/</span>
        <span class="gh-count-item"><strong id="ghFollowingCount">2</strong> Following</span>
        <span class="gh-sep">/</span>
        <span class="gh-count-item"><strong id="ghPublicReposCount">42</strong> Public Repositories</span>
      </div>
    </div>
  </div>

  <!-- Animated Live Metric Cards -->
  <div class="gh-metrics-deck" id="ghMetricsDeck">
    <div class="gh-metric-tile" data-tilt>
      <div class="gh-tile-glow" aria-hidden="true"></div>
      <div class="gh-tile-top">
        <span class="gh-tile-tag">CONTRIBUTIONS</span>
        <svg class="gh-tile-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M1.5 8a6.5 6.5 0 1 1 13 0 6.5 6.5 0 0 1-13 0ZM8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm.75 4.75a.75.75 0 0 0-1.5 0v3.5a.75.75 0 0 0 .37.65l2.5 1.5a.75.75 0 0 0 .76-1.3L8.75 7.92V4.75Z"></path>
        </svg>
      </div>
      <div class="gh-tile-number" data-target="228" id="statContributions">0</div>
      <div class="gh-tile-desc">Yearly Commits &amp; Pushes<small>365-day verified velocity</small></div>
    </div>

    <div class="gh-metric-tile" data-tilt>
      <div class="gh-tile-glow" aria-hidden="true"></div>
      <div class="gh-tile-top">
        <span class="gh-tile-tag">REPOSITORIES</span>
        <svg class="gh-tile-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25H12v2H5.25a.25.25 0 0 1-.25-.25Z"></path>
        </svg>
      </div>
      <div class="gh-tile-number" data-target="42" id="statRepos">0</div>
      <div class="gh-tile-desc">Active Codebases<small>OSS libraries &amp; full apps</small></div>
    </div>

    <div class="gh-metric-tile" data-tilt>
      <div class="gh-tile-glow" aria-hidden="true"></div>
      <div class="gh-tile-top">
        <span class="gh-tile-tag">ACTIVE STREAK</span>
        <svg class="gh-tile-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M9.504.43a1.5 1.5 0 0 1 1.264.508 7.502 7.502 0 0 1 1.76 4.708c.036 1.242-.294 2.518-.94 3.593-.655 1.092-1.637 1.944-2.735 2.378a3.25 3.25 0 0 1-4.22-3.155c0-.98.397-1.921 1.076-2.614.678-.693 1.584-1.127 2.47-1.282.887-.156 1.782-.047 2.485.347.16-.94-.01-1.932-.472-2.793A6.002 6.002 0 0 0 8 1.5c-1.89 0-3.612.87-4.75 2.25A7.502 7.502 0 0 0 1.5 9c0 4.142 3.358 7.5 7.5 7.5s7.5-3.358 7.5-7.5c0-1.76-.6-3.38-1.61-4.664a8.995 8.995 0 0 0-4.04-3.473L9.504.43Z"></path>
        </svg>
      </div>
      <div class="gh-tile-number" data-target="2" id="statStreak">0</div>
      <div class="gh-tile-desc">Days Active Current<small>consecutive push record</small></div>
    </div>

    <div class="gh-metric-tile" data-tilt>
      <div class="gh-tile-glow" aria-hidden="true"></div>
      <div class="gh-tile-top">
        <span class="gh-tile-tag">MAX STREAK</span>
        <svg class="gh-tile-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
        </svg>
      </div>
      <div class="gh-tile-number" data-target="9" id="statMaxStreak">0</div>
      <div class="gh-tile-desc">Days Peak Sprint<small>continuous commit streak</small></div>
    </div>
  </div>

  <!-- Telemetry Health Ribbon -->
  <div class="gh-health-ribbon">
    <div class="gh-health-pill">
      <span class="gh-pill-label">Commit Velocity</span>
      <span class="gh-pill-val">99.4% Consistency</span>
    </div>
    <div class="gh-health-pill">
      <span class="gh-pill-label">Primary Stack</span>
      <span class="gh-pill-val">Astro · React 19 · Node.js</span>
    </div>
    <div class="gh-health-pill">
      <span class="gh-pill-label">Production Deployments</span>
      <span class="gh-pill-val">Vercel &amp; Custom VPS</span>
    </div>
  </div>

  <!-- Interactive Language Radar & Filter Section -->
  <div class="gh-lang-card">
    <div class="gh-subhead-row">
      <h5 class="gh-section-title">
        <span>Language Architecture</span>
        <span class="gh-title-note">Click a language pill to filter featured codebases</span>
      </h5>
      <span class="gh-filter-indicator" id="ghActiveFilterLabel">Showing: All (6 Repos)</span>
    </div>

    <!-- Animated Multi-Segment Bar -->
    <div class="gh-lang-bar" id="ghLangBar" role="progressbar" aria-label="Language distribution bar">
      <div class="gh-bar-seg js" data-pct="33" style="width: 0%" title="JavaScript (33%)"></div>
      <div class="gh-bar-seg jupyter" data-pct="22" style="width: 0%" title="Jupyter Notebook (22%)"></div>
      <div class="gh-bar-seg ts" data-pct="11" style="width: 0%" title="TypeScript (11%)"></div>
      <div class="gh-bar-seg html" data-pct="11" style="width: 0%" title="HTML (11%)"></div>
      <div class="gh-bar-seg astro" data-pct="8" style="width: 0%" title="Astro (8%)"></div>
      <div class="gh-bar-seg other" data-pct="15" style="width: 0%" title="Python / Other (15%)"></div>
    </div>

    <!-- Filter Buttons -->
    <div class="gh-lang-filters" id="ghLangFilters" role="tablist" aria-label="Filter repositories by technology">
      <button class="gh-filter-btn is-active" data-filter="all" type="button" role="tab" aria-selected="true">
        <span class="gh-dot dot-all"></span> All Codebases <strong>(6)</strong>
      </button>
      <button class="gh-filter-btn" data-filter="client" type="button" role="tab" aria-selected="false">
        <span class="gh-dot dot-client"></span> Client Projects <strong>(2)</strong>
      </button>
      <button class="gh-filter-btn" data-filter="ai" type="button" role="tab" aria-selected="false">
        <span class="gh-dot dot-ai"></span> AI &amp; Apps <strong>Live</strong>
      </button>
      <button class="gh-filter-btn" data-filter="js" type="button" role="tab" aria-selected="false">
        <span class="gh-dot dot-js"></span> JavaScript <strong>33%</strong>
      </button>
      <button class="gh-filter-btn" data-filter="ts" type="button" role="tab" aria-selected="false">
        <span class="gh-dot dot-ts"></span> TypeScript <strong>11%</strong>
      </button>
      <button class="gh-filter-btn" data-filter="astro" type="button" role="tab" aria-selected="false">
        <span class="gh-dot dot-astro"></span> Astro <strong>8%</strong>
      </button>
      <button class="gh-filter-btn" data-filter="react" type="button" role="tab" aria-selected="false">
        <span class="gh-dot dot-react"></span> React 19 <strong>Core</strong>
      </button>
    </div>
  </div>

  <!-- Authentic 52-Week Contribution Matrix -->
  <div class="gh-matrix-card">
    <div class="gh-matrix-head">
      <div class="gh-matrix-title-wrap">
        <h5 class="gh-section-title">
          <span>Contribution Matrix</span>
          <span class="gh-title-note">Last 365 Days · 52 Weeks Activity</span>
        </h5>
      </div>
      <div class="gh-matrix-stats-meta">
        <span class="gh-matrix-total"><strong>228</strong> contributions logged</span>
      </div>
    </div>

    <!-- Months Header Row -->
    <div class="gh-matrix-months" aria-hidden="true">
      <span>Oct</span><span>Nov</span><span>Dec</span><span>Jan</span>
      <span>Feb</span><span>Mar</span><span>Apr</span><span>May</span>
      <span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span>
      <span>Oct</span>
    </div>

    <!-- Contribution Matrix Wrapper -->
    <div class="gh-matrix-viewport">
      <div class="gh-matrix-days-col" aria-hidden="true">
        <span>Mon</span>
        <span>Wed</span>
        <span>Fri</span>
      </div>
      <div class="gh-matrix-grid" id="ghContributionMatrix" role="img" aria-label="52-week GitHub contribution heatmap">
        <!-- Cells generated via script with authentic dates & contributions -->
      </div>
    </div>

    <!-- Heatmap Footer with Clickable Legend Levels -->
    <div class="gh-matrix-foot">
      <span class="gh-matrix-legend-label">Filter intensity:</span>
      <div class="gh-matrix-legend" id="ghLegendFilter" aria-label="Contribution level filter">
        <span class="gh-legend-text">Less</span>
        <button class="sq sq-0" data-level="0" type="button" title="Level 0: No activity"></button>
        <button class="sq sq-1" data-level="1" type="button" title="Level 1: 1-3 contributions"></button>
        <button class="sq sq-2" data-level="2" type="button" title="Level 2: 4-6 contributions"></button>
        <button class="sq sq-3" data-level="3" type="button" title="Level 3: 7-9 contributions"></button>
        <button class="sq sq-4" data-level="4" type="button" title="Level 4: 10+ contributions"></button>
        <span class="gh-legend-text">More</span>
        <button class="gh-legend-reset" id="ghResetLegendBtn" type="button">Reset</button>
      </div>
    </div>
  </div>

  <!-- Interactive Featured Repositories Showcase -->
  <div class="gh-repos-cockpit">
    <div class="gh-subhead-row">
      <h5 class="gh-section-title">
        <span>Featured Codebases</span>
        <span class="gh-title-note">Interactive repositories · 3D magnetic tilt &amp; instant clone</span>
      </h5>
      <span class="gh-card-count" id="ghVisibleRepoCount">6 of 6 displayed</span>
    </div>

    <div class="gh-repos-grid" id="ghReposGrid">
      <!-- Repo 1: Web_Projectect_Ai_Assistant -->
      <article class="gh-repo-card" data-tags="react ts ai all" data-tilt>
        <div class="gh-repo-sheen" aria-hidden="true"></div>
        <div class="gh-repo-top">
          <div class="gh-repo-name-wrap">
            <svg class="gh-repo-folder-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25H12v2H5.25a.25.25 0 0 1-.25-.25Z"></path>
            </svg>
            <h6 class="gh-repo-name">Web_Projectect_Ai_Assistant</h6>
          </div>
          <span class="gh-repo-tag ai">AI Tutor Engine</span>
        </div>

        <a class="gh-repo-thumb" href="https://web-projectect-ai-assistant-x8xz.vercel.app/" target="_blank" rel="noopener noreferrer" aria-label="Open Web Project AI Assistant live site">
          <img src="/projects/ai-assistant-01.webp" alt="Web Project AI Assistant — Live UI Preview" loading="lazy" width="480" height="270" />
          <div class="gh-repo-thumb-glow" aria-hidden="true"></div>
          <span class="gh-repo-thumb-badge live">⚡ Live Site ↗</span>
        </a>

        <p class="gh-repo-desc">
          AI Student Assistant platform featuring vision homework analysis, voice conversation mode, study history tracking, and intelligent tutoring dashboard.
        </p>
        <div class="gh-repo-meta">
          <span class="gh-tech-spec"><span class="gh-dot dot-react"></span> React · Vite · AI APIs</span>
          <div class="gh-star-fork">
            <span title="Stars">★ 1</span>
            <span title="Forks">⑂ 0</span>
          </div>
        </div>
        <div class="gh-repo-actions">
          <button class="gh-btn-clone" data-clone="https://github.com/hashirahmad806/Web_Projectect_Ai_Assistant.git" type="button">Copy Clone</button>
          <div class="gh-repo-links-group">
            <a class="gh-btn-live" href="https://web-projectect-ai-assistant-x8xz.vercel.app/" target="_blank" rel="noopener noreferrer">⚡ Live Demo ↗</a>
            <a class="gh-btn-visit" href="https://github.com/hashirahmad806/Web_Projectect_Ai_Assistant" target="_blank" rel="noopener noreferrer">Code &rarr;</a>
          </div>
        </div>
      </article>

      <!-- Repo 2: triostepdkhyber -->
