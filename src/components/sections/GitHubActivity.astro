  - Recent Sprints: Phase 05 Bio Roster, Celestial Physics, WebGL Orbit`,
      whoami: `Developer Profile:
  - Name: <span class="t-green">Hashir Ahmad</span> (@hashirahmad806)
  - Role: MERN Stack Developer & Scalable Web Engineer
  - Certs: Meta Certified Frontend & Full-Stack Specialist
  - Location: Pakistan / Remote Worldwide`,
    };

    function executeCommand(rawCmd: string) {
      if (!termHistory || !termBody) return;
      const cmd = rawCmd.trim().toLowerCase();

      if (cmd === 'clear') {
        termHistory.innerHTML = '';
        return;
      }

      const row = document.createElement('div');
      row.className = 'term-line term-line--cmd';
      row.innerHTML = `<span class="term-prompt">hashir:~$</span> ${rawCmd}`;

      const res = document.createElement('div');
      res.className = 'term-output';
      if (COMMANDS[cmd]) {
        res.innerHTML = `<div class="term-log-entry">${COMMANDS[cmd]}</div>`;
      } else if (cmd) {
        res.innerHTML = `<div class="term-log-entry t-red">zsh: command not found: ${rawCmd}. Type 'help' for available commands.</div>`;
      }

      termHistory.appendChild(row);
      if (cmd) termHistory.appendChild(res);
      termBody.scrollTop = termBody.scrollHeight;
    }

    termForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!termInput) return;
      const val = termInput.value;
      termInput.value = '';
      executeCommand(val);
    });

    document.querySelectorAll<HTMLButtonElement>('.gh-term-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const cmd = chip.getAttribute('data-cmd') || '';
        executeCommand(cmd);
      });
    });

    // ── 13. Dynamic GitHub REST API Fetch (Live Sync + Fallback) ──
    async function syncGitHubApi() {
      const CACHE_KEY = 'hashir_gh_cache_v1';
      const CACHE_TTL = 15 * 60 * 1000; // 15 mins

      try {
        const cached = localStorage.getItem(CACHE_KEY);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Date.now() - parsed.ts < CACHE_TTL) {
            applyUserData(parsed.data, true);
            return;
          }
        }

        const res = await fetch('https://api.github.com/users/hashirahmad806');
        if (res.ok) {
          const data = await res.json();
          localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data }));
          applyUserData(data, false);
        }
      } catch (err) {
        // Fallback silently without breaking UI
      }
    }

    function applyUserData(data: any, isCached: boolean) {
      const avatar = document.getElementById('ghAvatar') as HTMLImageElement | null;
      const followers = document.getElementById('ghFollowersCount');
      const following = document.getElementById('ghFollowingCount');
      const repos = document.getElementById('ghPublicReposCount');
      const statusBadge = document.getElementById('ghStatusBadge');

      if (avatar && data.avatar_url) avatar.src = data.avatar_url;
      if (followers && data.followers !== undefined) followers.textContent = data.followers;
      if (following && data.following !== undefined) following.textContent = data.following;
      if (repos && data.public_repos !== undefined) repos.textContent = data.public_repos;
      if (statusBadge) {
        statusBadge.textContent = isCached ? 'LIVE REST TELEMETRY (CACHED)' : 'LIVE REST SYNC · API v3';
      }
    }

    syncGitHubApi();

    // ── 14. GSAP ScrollTrigger Master Coordinator ──
    ScrollTrigger.create({
      trigger: cockpit,
      start: 'top 75%',
      onEnter: () => {
        animateCounters();
        animateLangBar();
        animateMatrixCells();
      },
    });

    // Stagger in repository cards on scroll
    ScrollTrigger.create({
      trigger: '#ghReposGrid',
      start: 'top 95%',
      onEnter: () => {
        gsap.fromTo(
          '.gh-repo-card:not(.is-hidden)',
          { opacity: 0, y: 24 },
          { opacity: 1, y: 0, stagger: 0.08, duration: 0.5, ease: 'power2.out' }
        );
      },
      once: true,
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGitHubTelemetry);
  } else {
    initGitHubTelemetry();
  }
  document.addEventListener('astro:page-load', initGitHubTelemetry);
</script>
