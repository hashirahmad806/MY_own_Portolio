        <div class="gh-repo-sheen" aria-hidden="true"></div>
        <div class="gh-repo-top">
          <div class="gh-repo-name-wrap">
            <svg class="gh-repo-folder-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25H12v2H5.25a.25.25 0 0 1-.25-.25Z"></path>
            </svg>
            <h6 class="gh-repo-name">triostepdkhyber</h6>
          </div>
          <span class="gh-repo-tag client">Client Project</span>
        </div>

        <a class="gh-repo-thumb" href="https://triostepdkhyber.vercel.app/" target="_blank" rel="noopener noreferrer" aria-label="Open Triostepdekhyaber live site">
          <img src="/projects/triostep-01.webp" alt="Triostepdekhyaber — Luxury E-Commerce Atelier Live Preview" loading="lazy" width="480" height="270" />
          <div class="gh-repo-thumb-glow" aria-hidden="true"></div>
