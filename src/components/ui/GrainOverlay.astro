---
// Procedural SVG Noise Grain Overlay
---

<div class="grain-overlay" aria-hidden="true">
  <svg class="grain-svg" xmlns="http://www.w3.org/2000/svg">
    <filter id="grain-filter">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.8"
        numOctaves="3"
        stitchTiles="stitch"
      />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-filter)" />
  </svg>
</div>

<style>
  .grain-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    pointer-events: none;
    z-index: 999;
    opacity: 0.045;
    mix-blend-mode: overlay;
    overflow: hidden;
  }

  .grain-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .grain-overlay {
      opacity: 0.03;
    }
  }
</style>
