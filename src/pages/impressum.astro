<style>
  :root {
    --key: clamp(24px, 2.2vw, 38px);
    --key-step: calc(var(--key) * 1.35);
    --key-top: clamp(120px, 15vh, 190px);
    --gasse: clamp(40px, 5.3vw, 130px);
  }

  .im-schleier {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    height: var(--key-top);
    background: linear-gradient(var(--bg) 0%, var(--bg) 72%, transparent 100%);
    pointer-events: none;
    z-index: 3;
  }

  .im-main {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--key-top) var(--rand) clamp(120px, 20vh, 260px);
    display: grid;
    grid-template-columns: minmax(0, 26%) minmax(0, 1fr);
    column-gap: var(--gasse);
    position: relative;
    z-index: 2;
  }

  .im-halt {
    position: sticky;
    z-index: 4;
    align-self: start;
  }

  .im-halt--eins {
    top: var(--key-top);
    grid-row: 1 / 3;
    grid-column: 1;
  }

  .im-halt--zwei {
    top: calc(var(--key-top) + var(--key-step));
    grid-row: 2 / 3;
    grid-column: 1;
  }

  .im-key {
    margin: 0;
    font-weight: 700;
    font-size: var(--key);
    line-height: 1.05;
    letter-spacing: 0.005em;
    color: var(--fg);
    transition: color 0.45s ease;
  }

  .im-halt.is-an .im-key {
    color: var(--accent);
  }

  .im-block {
    grid-column: 2;
  }

  .im-block--eins {
    grid-row: 1;
    min-height: 70vh;
    padding-bottom: clamp(120px, 22vh, 300px);
  }

  .im-block--zwei {
    grid-row: 2;
  }

  .im-block p {
    margin: 0 0 1.62em;
    font-weight: 400;
    letter-spacing: 0.01em;
    font-size: clamp(15px, 1.15vw, 19px);
    line-height: 1.62;
    max-width: 70ch;
  }

  .im-block p:last-child {
    margin-bottom: 0;
  }

  .im-block b {
    font-weight: 700;
  }

  .om-marke,
  .om-heureka {
    font-weight: 700;
  }

  .im-block a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }

  .im-block a:hover {
    color: var(--accent);
  }

  .im-fuss {
    padding: 0 var(--rand) 0;
    border-top: 1px solid color-mix(in srgb, var(--fg) 18%, var(--bg));
    font-size: 13px;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--fg) 62%, var(--bg));
  }

  .im-fuss-zeile {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: 13px 0 17px;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .im-fuss p {
    margin: 0;
  }

  .im-fuss a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .im-fuss a:hover {
    color: var(--fg);
  }

  .im-fuss-sozial {
    justify-self: end;
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .im-fuss-sozial svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  @media (max-width: 1200px) {
    .im-fuss-lang {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .im-main {
      grid-template-columns: 1fr;
    }

    .im-halt {
      position: static;
    }

    .im-halt--eins {
      grid-row: 1;
      grid-column: 1;
    }

    .im-halt--zwei {
      grid-row: 3;
      grid-column: 1;
      margin-top: clamp(60px, 10vh, 120px);
    }

    .im-block--eins {
      grid-row: 2;
      grid-column: 1;
      min-height: 0;
      padding-bottom: 0;
      margin-top: clamp(18px, 3vh, 30px);
    }

    .im-block--zwei {
      grid-row: 4;
      grid-column: 1;
      margin-top: clamp(18px, 3vh, 30px);
    }

    .im-fuss-zeile {
      gap: 10px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .im-key {
      transition: none;
    }
  }
</style>

<script>
  // Sticky topic key highlight for Impressum page
  document.addEventListener('DOMContentLoaded', () => {
    const paare = [
      {
        halt: document.querySelector<HTMLElement>('.im-halt--eins'),
        block: document.querySelector<HTMLElement>('.im-block--eins'),
      },
      {
        halt: document.querySelector<HTMLElement>('.im-halt--zwei'),
        block: document.querySelector<HTMLElement>('.im-block--zwei'),
      },
    ];

    if (paare.some((p) => !p.halt || !p.block)) return;

    function pruefen() {
      let aktiv = 0;
      for (let i = paare.length - 1; i >= 0; i--) {
        const klebe = parseFloat(getComputedStyle(paare[i].halt!).top) || 0;
        if (paare[i].block!.getBoundingClientRect().top <= klebe + 1) {
          aktiv = i;
          break;
        }
      }
      paare.forEach((p, i) => {
        p.halt!.classList.toggle('is-an', i === aktiv);
      });
    }

    let geplant = false;
    function anstossen() {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(() => {
        geplant = false;
        pruefen();
      });
    }

    pruefen();
    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen);
  });
</script>
