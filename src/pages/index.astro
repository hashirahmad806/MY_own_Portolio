---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import OrbitShowcase from '../components/sections/OrbitShowcase.astro';
import HybridAI from '../components/sections/HybridAI.astro';
---

<Layout>
  <!-- 01: Hero Marquee & Gravitize Physics Section -->
  <Hero />

  <!-- 02: Full-Bleed Lilac Manifesto with Bold Curve & Rotating Ring -->
  <Manifesto />

  <!-- 03: Interactive 3D Perspective Orbit Universe with Real Case Studies -->
  <OrbitShowcase />

  <!-- 04: Hybrid AI Narrative & Interactive Constellation Plexus -->
  <HybridAI />

  <!-- 05: Bio & Hall of Awards Preview (Phase 5 Target) -->
  <section id="bio" class="preview-section container" aria-label="Bio Preview">
    <div class="glass-panel preview-card">
      <span class="text-meta text-accent">05 · My Story & Awards</span>
      <h2 class="preview-title">Visual Strategist & Creative Visualizer.</h2>
      <p class="preview-text">
        ’72 geboren als „irgendwas mit kreativ“. Danach Mediengestalter, Diplom Grafik-Designer FH, Creative Director und Mitinhaber der heureka GmbH (unter den Top 50 PAGE-Agenturen Deutschlands). Gewinner des Red Dot Grand Prix 2025, Best of the Best, ADC 2023 & 2025 und German Design Award Gold.
      </p>
    </div>
  </section>
</Layout>

<style>
  .preview-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-top: var(--section-gap);
    padding-bottom: var(--section-gap);
    position: relative;
    z-index: 2;
  }

  .preview-card {
    padding: clamp(2rem, 4vw, 4rem);
    max-width: 860px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform var(--duration-normal) var(--ease-standard),
                border-color var(--duration-normal) var(--ease-standard);
  }

  .preview-card:hover {
    transform: translateY(-4px);
    border-color: rgba(180, 129, 248, 0.35);
  }

  .preview-title {
    font-size: var(--font-h2);
    font-weight: 700;
    line-height: 1.2;
  }

  .preview-text {
    font-size: var(--font-body-large);
    color: var(--fg-muted);
    line-height: 1.65;
  }
</style>
