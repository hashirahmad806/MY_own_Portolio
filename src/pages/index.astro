---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
---

<Layout>
  <!-- Marquee Kinetic Hero & Gravitize Physics Section -->
  <Hero />

  <!-- Section Anchor: Manifesto (Phase 4 Target) -->
  <section id="manifesto" class="preview-section container" aria-label="Manifesto Preview">
    <div class="glass-panel preview-card">
      <span class="text-meta text-accent">01 · Manifest</span>
      <h2 class="preview-title">Agentur ohne Agentur.</h2>
      <p class="preview-text">
        35 Jahre Erfahrung. Kein Overhead. Gute Ideen sind am Anfang oft fragil. Zu viele Abstimmungen und Prozesse nehmen ihnen den Mut. Strategie gibt Halt — Erfahrung zeigt, was funktioniert.
      </p>
    </div>
  </section>

  <!-- Section Anchor: Bio (Phase 5 Target) -->
  <section id="bio" class="preview-section container" aria-label="Bio Preview">
    <div class="glass-panel preview-card">
      <span class="text-meta text-accent">02 · My Story</span>
      <h2 class="preview-title">Visual Strategist & Creative Visualizer.</h2>
      <p class="preview-text">
        Vom Mediengestalter zum Creative Director und Mitinhaber der Agentur heureka GmbH (unter den Top 50 PAGE-Agenturen Deutschlands) bis zum Neustart mit gravity.
      </p>
    </div>
  </section>
</Layout>

<style>
  .preview-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-top: var(--section-gap);
    padding-bottom: var(--section-gap);
  }

  .preview-card {
    padding: clamp(2rem, 4vw, 4rem);
    max-width: 860px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform var(--duration-normal) var(--ease-standard),
                border-color var(--duration-normal) var(--ease-standard);
  }

  .preview-card:hover {
    transform: translateY(-4px);
    border-color: rgba(180, 129, 248, 0.35);
  }

  .preview-title {
    font-size: var(--font-h2);
    font-weight: 700;
    line-height: 1.2;
  }

  .preview-text {
    font-size: var(--font-body-large);
    color: var(--fg-muted);
    line-height: 1.65;
  }
</style>
