---
import '../styles/global.css';
import GrainOverlay from '../components/ui/GrainOverlay.astro';
import CustomCursor from '../components/ui/CustomCursor.astro';
import Header from '../components/sections/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "gravity — Gorden Koschel — strategy · concept · design",
  description = "Agentur ohne Agentur: Corporate Design, Geschäfts- und Nachhaltigkeitsberichte, Creative Direction und AI Agents. 35 Jahre Erfahrung.",
  image = "/portrait.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://gravity-design.de");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Gorden Koschel" />
    <meta name="theme-color" content="#101010" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Preload Depth Background & Portrait -->
    <link rel="preload" as="image" href="/portrait.jpg" fetchpriority="high" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "gravity",
        "alternateName": "gravity design",
        "url": "https://gravity-design.de/",
        "email": "losgehts@gravity-design.de",
        "founder": {
          "@type": "Person",
          "name": "Gorden Koschel",
          "jobTitle": "Visual Strategist & Creative Visualizer"
        },
        "description": "Agentur ohne Agentur, Design aus Essen: Corporate Design, Geschäfts- und Nachhaltigkeitsberichte, Creative Direction und AI Agents."
      }
    </script>
  </head>
  <body>
    <!-- Ambient Depth Texture -->
    <div class="ambient-depth" aria-hidden="true"></div>

    <!-- Tactile Grain Overlay -->
    <GrainOverlay />

    <!-- Custom Dual-Layer Magnetic Cursor -->
    <CustomCursor />

    <!-- Editorial Header Navigation -->
    <Header />

    <main id="app-root">
      <slot />
    </main>

    <!-- Synchronized Lenis + GSAP Motion Engine -->
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  #app-root {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
</style>
